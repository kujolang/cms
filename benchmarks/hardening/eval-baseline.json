{
  "name": "cms-hardening-baseline",
  "description": "Kujo Eval checks for the selected pre-hardening CMS baseline. One expected failure exposes the missing production safety gate.",
  "version": "1.0.0",
  "stop_on_failure": false,
  "tests": [
    { "name": "native contract pass 1", "check": "command_succeeds", "params": { "command": "node scripts/hardening-check.mjs baseline 0" } },
    { "name": "native contract pass 2", "check": "command_succeeds", "params": { "command": "node scripts/hardening-check.mjs baseline 1" } },
    { "name": "minimal workload succeeds", "check": "command_succeeds", "params": { "command": "node scripts/hardening-check.mjs baseline 2" } },
    { "name": "typical workload succeeds", "check": "command_succeeds", "params": { "command": "node scripts/hardening-check.mjs baseline 3" } },
    { "name": "large workload succeeds", "check": "command_succeeds", "params": { "command": "node scripts/hardening-check.mjs baseline 4" } },
    { "name": "invalid cursor rejected", "check": "command_succeeds", "params": { "command": "node scripts/hardening-check.mjs baseline 5" } },
    { "name": "unauthorized write rejected", "check": "command_succeeds", "params": { "command": "node scripts/hardening-check.mjs baseline 6" } },
    { "name": "missing entry is 404", "check": "command_succeeds", "params": { "command": "node scripts/hardening-check.mjs baseline 7" } },
    { "name": "anonymous draft not disclosed", "check": "command_succeeds", "params": { "command": "node scripts/hardening-check.mjs baseline 8" } },
    { "name": "agent evidence remains present", "check": "command_succeeds", "params": { "command": "node scripts/hardening-check.mjs baseline 9" } },
    { "name": "unsafe production config rejected", "check": "command_succeeds", "params": { "command": "node scripts/hardening-check.mjs baseline 10" } }
  ]
}

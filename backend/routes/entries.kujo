		normalized_slug = trim(normalized_slug)
		if normalized_slug != slug || starts_with(slug, "-") || starts_with(slug, "_") {
			return fail(cfg, 400, "invalid_slug", "slug must be lowercase slug text", {})
		}

		slug_rows := []
		slug_err := null
		try {
			slug_rows = db_query(
				db,
				"SELECT id FROM entries WHERE content_type_key = ? AND slug = ? AND id != ? LIMIT 1",
				[to_string(dict_get_or(existing_obj, "content_type_key", "")), slug, entry_id]
			)
		} except e {
			slug_err = e
		}
		if type(slug_err) != "null" {
			return fail(cfg, 500, "db_query_failed", "Failed to validate slug", {})
		}
		if len(slug_rows) > 0 {
			return fail(cfg, 409, "duplicate_slug", "slug must be unique per content type", {})
		}

		if status == "published" && type(published_at) == "null" {
			published_at = now()
		}

		update_err := null
		try {
			db_execute(
				db,
				"UPDATE entries SET title = ?, slug = ?, status = ?, excerpt = ?, body = ?, meta_json = ?, published_at = ?, unpublish_at = ?, updated_at = ? WHERE id = ?",
				[title, slug, status, excerpt, body_value, meta_json, published_at, unpublish_at, now(), entry_id]
			)
		} except e {
			update_err = e
		}
		if type(update_err) != "null" {
			return fail(cfg, 500, "update_failed", "Failed to update entry", {})
		}

		updated_rows := []
		updated_err := null
		try {
			updated_rows = db_query(db, "SELECT * FROM entries WHERE id = ?", [entry_id])
		} except e {
			updated_err = e
		}
		if type(updated_err) != "null" || len(updated_rows) == 0 {
			return fail(cfg, 500, "load_failed", "Updated entry but failed to load it", {})
		}
		_ = write_audit(ctx, req, "entry.patch", 200, "entry", entry_id, {
			"status": status,
			"slug": slug
		})

		return json_response(200, {"ok": true, "data": updated_rows[0]})
	})

	server = server.route("DELETE", "/v1/entries/:id", func(req) {
		guard := guard_request(req, ctx, true)
		if guard["ok"] == false {
			return guard["response"]
		}

		cfg := ctx["cfg"]
		db := ctx["db"]
		params := dict_get_or(req, "params", {})
		if type(params) != "dict" || has_key(params, "id") == 0 {
			return fail(cfg, 400, "invalid_id", "Missing required route parameter: id", {})
		}

		entry_id := -1
		entry_id_err := null
		try {
			entry_id = parse_int(to_string(params["id"]))
		} except e {
			entry_id_err = e
		}
		if type(entry_id_err) != "null" || entry_id <= 0 {
			return fail(cfg, 400, "invalid_id", "id must be a positive integer", {})
		}

		lock_rows := []
		lock_err := null
		now_ts := now()
		try {
			lock_rows = db_query(db, "SELECT entry_id FROM entry_locks WHERE entry_id = ? AND CASE WHEN instr(CAST(expires_at AS TEXT), '-') > 0 THEN CAST(strftime('%s', expires_at) AS INTEGER) * 1000 ELSE CAST(expires_at AS INTEGER) END > ? LIMIT 1", [entry_id, now_ts])
		} except e {
			lock_err = e
		}
		if type(lock_err) != "null" || type(lock_rows) == "error" {
			return fail(cfg, 500, "db_query_failed", "Failed to resolve entry lock state", {})
		}
		if len(lock_rows) > 0 {
			return fail(cfg, 409, "entry_locked", "Entry is currently locked", {})
		}

		delete_err := null
		try {
			db_execute(db, "DELETE FROM entries WHERE id = ?", [entry_id])
		} except e {
			delete_err = e
		}
		if type(delete_err) != "null" {
			return fail(cfg, 500, "delete_failed", "Failed to delete entry", {})
		}
		audit_err := null
		try {
			_ = write_audit(ctx, req, "entry.delete", 200, "entry", entry_id, {
				"deleted": true
			})
		} except e {
			audit_err = e
		}
		response_payload := {"ok": true, "data": {"deleted": true, "id": entry_id}}
		_ = idempotency_complete(req, ctx, 200, response_payload)
		return json_response(200, response_payload)
	})

	server = server.route("POST", "/v1/entries/:id/terms", func(req) {
		guard := guard_request(req, ctx, true)
		if guard["ok"] == false {
			return guard["response"]
		}

		cfg := ctx["cfg"]
		db := ctx["db"]
		params := dict_get_or(req, "params", {})
		if has_key(params, "id") == 0 {
			return fail(cfg, 400, "invalid_id", "Missing required route parameter: id", {})
		}

		entry_id := -1
		id_err := null
		try {
			entry_id = parse_int(to_string(params["id"]))
		} except e {
			id_err = e
		}
		if type(id_err) != "null" || entry_id <= 0 {
			return fail(cfg, 400, "invalid_id", "id must be a positive integer", {})
		}

		entry_rows := []
		entry_err := null
		try {
			entry_rows = db_query(db, "SELECT id FROM entries WHERE id = ?", [entry_id])
		} except e {
			entry_err = e
		}
		if type(entry_err) != "null" {
			return fail(cfg, 500, "db_query_failed", "Failed to load entry", {})
		}
		if len(entry_rows) == 0 {
			return fail(cfg, 404, "not_found", "Entry not found", {})
		}

		body_text := to_string(dict_get_or(req, "body", ""))
		if trim(body_text) == "" {
			return fail(cfg, 400, "invalid_body", "Request body is required", {})
		}
		max_body_bytes := dict_get_or(cfg, "max_body_bytes", 1048576)
		if len(body_text) > max_body_bytes {
			return fail(cfg, 400, "invalid_body", "Request body exceeds max size", {})
		}
		headers := dict_get_or(req, "headers", {})
		content_type := ""
		if type(headers) == "dict" && has_key(headers, "Content-Type") == 1 {
			content_type = to_lower(to_string(headers["Content-Type"]))
		}
		if content_type == "" && type(headers) == "dict" && has_key(headers, "content-type") == 1 {
			content_type = to_lower(to_string(headers["content-type"]))
		}
		if content_type != "" && starts_with(content_type, "application/json") == false {
			return fail(cfg, 400, "invalid_body", "Content-Type must be application/json", {})
		}
		parse_err := null
		body := null
		try {
			body = parse_json(body_text)
		} except e {
			parse_err = e
		}
		if type(parse_err) != "null" || type(body) != "dict" {
			return fail(cfg, 400, "invalid_body", "Invalid JSON body", {})
		}
		if has_key(body, "term_ids") == 0 || type(body["term_ids"]) != "array" {
			return fail(cfg, 400, "invalid_term_ids", "term_ids must be an array", {})
		}

		term_ids := body["term_ids"]
		valid_ids := []
		invalid_ids := []
		for term_id_raw in term_ids {
			term_id := to_int(term_id_raw)
			if term_id <= 0 {
				invalid_ids = push(invalid_ids, term_id)
				continue
			}
			term_rows := []
			term_err := null
			try {
				term_rows = db_query(db, "SELECT id FROM taxonomy_terms WHERE id = ?", [term_id])
			} except e {
				term_err = e
			}
			if type(term_err) != "null" || len(term_rows) == 0 {
				invalid_ids = push(invalid_ids, term_id)
				continue
			}
			valid_ids = push(valid_ids, term_id)
		}

		if len(invalid_ids) > 0 {
			return fail(cfg, 400, "invalid_term_ids", "One or more term IDs are invalid", {
				"invalid_term_ids": invalid_ids
			})
		}

		delete_err := null
		try {
			db_execute(db, "DELETE FROM entry_terms WHERE entry_id = ?", [entry_id])
		} except e {
			delete_err = e
		}
		if type(delete_err) != "null" {
			return fail(cfg, 500, "update_failed", "Failed to update entry terms", {})
		}

		for term_id in valid_ids {
			insert_err := null
			try {
				db_execute(
					db,
					"INSERT OR IGNORE INTO entry_terms (entry_id, term_id, created_at) VALUES (?, ?, ?)",
					[entry_id, term_id, now()]
				)
			} except e {
				insert_err = e
			}
			if type(insert_err) != "null" {
				return fail(cfg, 500, "update_failed", "Failed to assign one or more terms", {})
			}
		}

		assigned := []
		assigned_err := null
		try {
			assigned = db_query(
				db,
				"SELECT t.id, t.name, t.slug FROM taxonomy_terms t INNER JOIN entry_terms et ON et.term_id = t.id WHERE et.entry_id = ? ORDER BY t.name ASC",
				[entry_id]
			)
		} except e {
			assigned_err = e
		}
		if type(assigned_err) != "null" {
			return fail(cfg, 500, "db_query_failed", "Failed to load assigned terms", {})
		}
		terms_audit_err := null
		try {
			_ = write_audit(ctx, req, "entry.terms.update", 200, "entry", entry_id, {
				"term_count": len(assigned)
			})
		} except e {
			terms_audit_err = e
		}

		return json_response(200, {"ok": true, "data": {"entry_id": entry_id, "terms": assigned}})
	})

	return server
}

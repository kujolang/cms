		}
		if slug == "" {
			slug = to_lower(title)
			slug = regex_replace(slug, "[^a-z0-9\\s\\-]", "")
			slug = regex_replace(slug, "\\s+", "-")
			slug = regex_replace(slug, "-{2,}", "-")
			slug = trim(slug)
			if starts_with(slug, "-") {
				slug = substring(slug, 1, len(slug))
			}
			if ends_with(slug, "-") {
				slug = substring(slug, 0, len(slug) - 1)
			}
		}

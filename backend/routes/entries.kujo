			return fail(cfg, 404, "not_found", "Entry not found", {})
		}
		if can_read_entry_status(dict_get_or(guard, "auth", {}), dict_get_or(entry_rows[0], "status", "")) == false {
			return fail(cfg, 404, "not_found", "Entry not found", {})
		}

		term_rows := []
		term_err := null
		try {
			term_rows = db_query(
				db,
				"SELECT t.id, t.name, t.slug FROM taxonomy_terms t INNER JOIN entry_terms et ON et.term_id = t.id WHERE et.entry_id = ? ORDER BY t.name ASC",
				[entry_id]
			)
		} except e {
			term_err = e
		}
		if type(term_err) != "null" {
			return fail(cfg, 500, "db_query_failed", "Failed to load entry terms", {})
		}

		entry_payload := entry_rows[0]
		entry_payload["terms"] := term_rows
		return json_response(200, {"ok": true, "data": entry_payload})
	})


			)
		} except e {
			slug_err = e
		}
		if type(slug_err) != "null" {
			return fail(cfg, 500, "db_query_failed", "Failed to validate slug", {})
		}
		if len(slug_rows) > 0 {
			return fail(cfg, 409, "duplicate_slug", "slug must be unique per content type", {})
		}

		if status == "published" && type(published_at) == "null" {
			published_at = now()
		}

		update_err := null
		try {
			db_execute(
				db,
				"UPDATE entries SET title = ?, slug = ?, status = ?, excerpt = ?, body = ?, meta_json = ?, published_at = ?, unpublish_at = ?, updated_at = ? WHERE id = ?",
				[title, slug, status, excerpt, body_value, meta_json, published_at, unpublish_at, now(), entry_id]
			)
		} except e {
			update_err = e
		}
		if type(update_err) != "null" {
			return fail(cfg, 500, "update_failed", "Failed to update entry", {})
		}

		updated_rows := []
		updated_err := null
		try {
			updated_rows = db_query(db, "SELECT * FROM entries WHERE id = ?", [entry_id])
		} except e {
			updated_err = e
		}
		if type(updated_err) != "null" || len(updated_rows) == 0 {
			return fail(cfg, 500, "load_failed", "Updated entry but failed to load it", {})
		}
		_ = write_audit(ctx, req, "entry.update", 200, "entry", entry_id, {
			"status": status,
			"slug": slug
		})

		return json_response(200, {"ok": true, "data": updated_rows[0]})
	})


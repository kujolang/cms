		}
		if content_type == "" && type(headers) == "dict" && has_key(headers, "content-type") == 1 {
			content_type = to_lower(to_string(headers["content-type"]))
		}
		if content_type != "" {
			json_ok := starts_with(content_type, "application/json")
			patch_ok := starts_with(content_type, "application/merge-patch+json")

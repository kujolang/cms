			return fail(cfg, 400, "invalid_id", "Missing required route parameter: id", {})
		}
		entry_id := -1
		entry_id_err := null
		try {
			entry_id = parse_int(to_string(params["id"]))
		} except e {
			entry_id_err = e
		}
		if type(entry_id_err) != "null" || entry_id <= 0 {
			return fail(cfg, 400, "invalid_id", "id must be a positive integer", {})
		}

		entry_rows := []
		entry_err := null
		try {
			entry_rows = db_query(db, "SELECT * FROM entries WHERE id = ?", [entry_id])
		} except e {
			entry_err = e
		}
		if type(entry_err) != "null" {
			return fail(cfg, 500, "db_query_failed", "Failed to load entry", {})
		}

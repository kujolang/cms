			return fail(cfg, 400, "invalid_body", "Invalid JSON body", {})
		}
		if has_key(body, "title") == 0 || has_key(body, "body") == 0 {
			return fail(cfg, 400, "missing_fields", "PUT requires title and body", {})
		}
		title := trim(to_string(dict_get_or(body, "title", dict_get_or(existing_obj, "title", ""))))
		body_value := trim(to_string(dict_get_or(body, "body", dict_get_or(existing_obj, "body", ""))))
		excerpt := trim(to_string(dict_get_or(body, "excerpt", dict_get_or(existing_obj, "excerpt", ""))))
		status := to_lower(trim(to_string(dict_get_or(body, "status", dict_get_or(existing_obj, "status", "draft")))))
		slug := trim(to_string(dict_get_or(body, "slug", dict_get_or(existing_obj, "slug", ""))))
		meta_json := to_string(dict_get_or(existing_obj, "meta_json", "{}"))
		if has_key(body, "meta") == 1 {
			meta_json = ensure_json_text(body["meta"], {})
		}
		published_at := dict_get_or(body, "published_at", dict_get_or(existing_obj, "published_at", null))
		unpublish_at := dict_get_or(body, "unpublish_at", dict_get_or(existing_obj, "unpublish_at", null))
		if len(title) < 2 {
			return fail(cfg, 400, "invalid_title", "title must be at least 2 characters", {})

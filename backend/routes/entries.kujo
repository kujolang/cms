		return json_response(200, {"ok": true, "data": {
			"entry_id": entry_id,
			"items": rows,
			"count": len(rows),
			"limit": limit
		}})
	})

	server = server.route("POST", "/v1/entries/:id/revisions", func(req) {
		guard := guard_request(req, ctx, true)
		if guard["ok"] == false {
			return guard["response"]
		}

		cfg := ctx["cfg"]
		db := ctx["db"]
		params := dict_get_or(req, "params", {})
		if has_key(params, "id") == 0 {
			return fail(cfg, 400, "invalid_id", "Missing required route parameter: id", {})
		}

		entry_id := -1
		id_err := null
		try {
			entry_id = parse_int(to_string(params["id"]))
		} except e {
			id_err = e
		}
		if type(id_err) != "null" || entry_id <= 0 {
			return fail(cfg, 400, "invalid_id", "id must be a positive integer", {})
		}

		revision_note := ""
		body_text := to_string(dict_get_or(req, "body", ""))
		if trim(body_text) != "" {
			max_body_bytes := dict_get_or(cfg, "max_body_bytes", 1048576)
			if len(body_text) > max_body_bytes {
				return fail(cfg, 400, "invalid_body", "Request body exceeds max size", {})
			}
			headers := dict_get_or(req, "headers", {})
			content_type := ""
			if type(headers) == "dict" && has_key(headers, "Content-Type") == 1 {
				content_type = to_lower(to_string(headers["Content-Type"]))
			}
			if content_type == "" && type(headers) == "dict" && has_key(headers, "content-type") == 1 {
				content_type = to_lower(to_string(headers["content-type"]))
			}
			if content_type != "" && starts_with(content_type, "application/json") == false {
				return fail(cfg, 400, "invalid_body", "Content-Type must be application/json", {})
			}
		}
		if trim(body_text) != "" {
			body := null
			parse_err := null
			try {
				body = parse_json(body_text)
			} except e {
				parse_err = e
			}
			if type(parse_err) != "null" || type(body) != "dict" {
				return fail(cfg, 400, "invalid_body", "Invalid JSON body", {})
			}
			revision_note = trim(to_string(dict_get_or(body, "note", "")))
		}

		entry_rows := []
		entry_err := null
		try {
			entry_rows = db_query(
				db,
				"SELECT id, title, slug, status, excerpt, body, meta_json, author_id, published_at FROM entries WHERE id = ? LIMIT 1",
				[entry_id]
			)
		} except e {
			entry_err = e
		}
		if type(entry_err) != "null" {
			return fail(cfg, 500, "db_query_failed", "Failed to load entry for revision snapshot", {})
		}
		if len(entry_rows) == 0 {
			return fail(cfg, 404, "not_found", "Entry not found", {})
		}

		entry_row := entry_rows[0]
		insert_err := null
		now_ts := now()
		try {
			db_execute(
				db,
				"INSERT INTO entry_revisions (entry_id, title, slug, status, excerpt, body, meta_json, author_id, published_at, revision_note, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
				[
					entry_id,
					to_string(dict_get_or(entry_row, "title", "")),
					to_string(dict_get_or(entry_row, "slug", "")),
					to_string(dict_get_or(entry_row, "status", "draft")),
					to_string(dict_get_or(entry_row, "excerpt", "")),
					to_string(dict_get_or(entry_row, "body", "")),
					to_string(dict_get_or(entry_row, "meta_json", "{}")),
					to_string(dict_get_or(entry_row, "author_id", "system")),
					dict_get_or(entry_row, "published_at", null),
					revision_note,
					now_ts
				]
			)
		} except e {
			insert_err = e
		}
		if type(insert_err) != "null" {
			return fail(cfg, 500, "create_failed", "Failed to create entry revision snapshot", {})
		}

		rev_rows := []
		rev_err := null
		try {
			rev_rows = db_query(
				db,
				"SELECT id, entry_id, title, slug, status, excerpt, body, meta_json, author_id, published_at, revision_note, created_at FROM entry_revisions WHERE entry_id = ? ORDER BY id DESC LIMIT 1",
				[entry_id]
			)
		} except e {
			rev_err = e
		}
		if type(rev_err) != "null" || len(rev_rows) == 0 {
			return fail(cfg, 500, "load_failed", "Created revision but failed to load it", {})
		}
		audit_err := null
		try {
			_ = write_audit(ctx, req, "entry.revision.create", 201, "entry_revision", dict_get_or(rev_rows[0], "id", 0), {
				"entry_id": entry_id
			})
		} except e {
			audit_err = e
		}

		return json_response(201, {"ok": true, "data": rev_rows[0]})
	})

	server = server.route("POST", "/v1/entries/:id/revisions/:revision_id/restore", func(req) {
		guard := guard_request(req, ctx, true)
		if guard["ok"] == false {
			return guard["response"]
		}

		cfg := ctx["cfg"]
		db := ctx["db"]
		params := dict_get_or(req, "params", {})
		if has_key(params, "id") == 0 || has_key(params, "revision_id") == 0 {
			return fail(cfg, 400, "invalid_id", "id and revision_id route parameters are required", {})
		}

		entry_id := -1
		revision_id := -1
		id_err := null
		revision_id_err := null
		try {
			entry_id = parse_int(to_string(params["id"]))
		} except e {
			id_err = e
		}
		try {
			revision_id = parse_int(to_string(params["revision_id"]))
		} except e {
			revision_id_err = e
		}
		if type(id_err) != "null" || entry_id <= 0 {
			return fail(cfg, 400, "invalid_id", "id must be a positive integer", {})
		}
		if type(revision_id_err) != "null" || revision_id <= 0 {
			return fail(cfg, 400, "invalid_revision_id", "revision_id must be a positive integer", {})
		}

		lock_rows := []
		lock_err := null
		now_ts := now()
		try {
			lock_rows = db_query(
				db,
				"SELECT entry_id FROM entry_locks WHERE entry_id = ? AND CASE WHEN instr(CAST(expires_at AS TEXT), '-') > 0 THEN CAST(strftime('%s', expires_at) AS INTEGER) * 1000 ELSE CAST(expires_at AS INTEGER) END > ? LIMIT 1",
				[entry_id, now_ts]
			)
		} except e {
			lock_err = e
		}
		if type(lock_err) != "null" || type(lock_rows) == "error" {
			return fail(cfg, 500, "db_query_failed", "Failed to resolve entry lock state", {})
		}
		if len(lock_rows) > 0 {
			return fail(cfg, 409, "entry_locked", "Entry is currently locked", {})
		}

		current_rows := []
		current_err := null
		try {
			current_rows = db_query(
				db,
				"SELECT id, content_type_key, title, slug, status, excerpt, body, meta_json, author_id, published_at FROM entries WHERE id = ? LIMIT 1",
				[entry_id]
			)
		} except e {
			current_err = e
		}
		if type(current_err) != "null" {
			return fail(cfg, 500, "db_query_failed", "Failed to load entry for rollback", {})
		}
		if len(current_rows) == 0 {
			return fail(cfg, 404, "not_found", "Entry not found", {})
		}
		current_entry := current_rows[0]

		revision_rows := []
		revision_err := null
		try {
			revision_rows = db_query(
				db,
				"SELECT id, entry_id, title, slug, status, excerpt, body, meta_json, author_id, published_at FROM entry_revisions WHERE id = ? AND entry_id = ? LIMIT 1",
				[revision_id, entry_id]
			)
		} except e {
			revision_err = e
		}
		if type(revision_err) != "null" {
			return fail(cfg, 500, "db_query_failed", "Failed to load revision for rollback", {})
		}
		if len(revision_rows) == 0 {
			return fail(cfg, 404, "revision_not_found", "Revision not found for entry", {})
		}
		revision_entry := revision_rows[0]

		now_ts := now()
		pre_restore_note := "pre_restore_backup_from_revision_" + to_string(revision_id)
		backup_err := null
		try {
			db_execute(
				db,
				"INSERT INTO entry_revisions (entry_id, title, slug, status, excerpt, body, meta_json, author_id, published_at, revision_note, created_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
				[
					entry_id,
					to_string(dict_get_or(current_entry, "title", "")),
					to_string(dict_get_or(current_entry, "slug", "")),
					to_string(dict_get_or(current_entry, "status", "draft")),
					to_string(dict_get_or(current_entry, "excerpt", "")),
					to_string(dict_get_or(current_entry, "body", "")),
					to_string(dict_get_or(current_entry, "meta_json", "{}")),
					to_string(dict_get_or(current_entry, "author_id", "system")),
					dict_get_or(current_entry, "published_at", null),
					pre_restore_note,
					now_ts
				]
			)
		} except e {
			backup_err = e
		}
		if type(backup_err) != "null" {
			return fail(cfg, 500, "create_failed", "Failed to snapshot pre-restore state", {})
		}

		restore_err := null
		try {
			db_execute(
				db,
				"UPDATE entries SET title = ?, slug = ?, status = ?, excerpt = ?, body = ?, meta_json = ?, author_id = ?, published_at = ?, updated_at = ? WHERE id = ?",
				[
					to_string(dict_get_or(revision_entry, "title", "")),
					to_string(dict_get_or(revision_entry, "slug", "")),
					to_string(dict_get_or(revision_entry, "status", "draft")),
					to_string(dict_get_or(revision_entry, "excerpt", "")),
					to_string(dict_get_or(revision_entry, "body", "")),
					to_string(dict_get_or(revision_entry, "meta_json", "{}")),
					to_string(dict_get_or(revision_entry, "author_id", "system")),
					dict_get_or(revision_entry, "published_at", null),
					now_ts,
					entry_id
				]
			)
		} except e {
			restore_err = e
		}
		if type(restore_err) != "null" {
			return fail(cfg, 500, "restore_failed", "Failed to restore entry from revision", {})
		}

		restored_rows := []
		restored_err := null
		try {
			restored_rows = db_query(db, "SELECT * FROM entries WHERE id = ? LIMIT 1", [entry_id])
		} except e {
			restored_err = e
		}
		if type(restored_err) != "null" || len(restored_rows) == 0 {
			return fail(cfg, 500, "load_failed", "Entry restored but failed to reload it", {})
		}
		audit_err := null
		try {
			_ = write_audit(ctx, req, "entry.revision.restore", 200, "entry", entry_id, {
				"revision_id": revision_id
			})
		} except e {
			audit_err = e
		}

		return json_response(200, {"ok": true, "data": {
			"entry": restored_rows[0],
			"restored_from_revision_id": revision_id
		}})
	})

	server = server.route("GET", "/v1/entries/:id", func(req) {
		guard := guard_request(req, ctx, false)
		if guard["ok"] == false {
			return guard["response"]
		}

		cfg := ctx["cfg"]

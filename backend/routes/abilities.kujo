export resolved_connector_registry := func(ctx) {
	items := []
	for item in connector_registry(ctx["cfg"]) {
		item["enabled"] := feature_state(ctx["db"], "connector", item["key"], item["configured"])
		item["source"] := "core"
		item["manageable"] := true
		if item["enabled"] == true { item["status"] := "active" }
		if item["configured"] == true && item["enabled"] == false { item["status"] := "inactive" }
		items = push(items, item)
	}
	registry := extension_ai_registry(ctx["db"])
	for raw in registry["connectors"] {
		connector_key := raw["source_key"] + "-" + trim(to_string(dict_get_or(raw, "key", "connector")))
		connector_enabled := feature_state(ctx["db"], "connector", connector_key, true)
		plugin_status := "inactive"; if connector_enabled { plugin_status = "active" }
		items = push(items, {
			"key": connector_key,
			"label": trim(to_string(dict_get_or(raw, "label", "Plugin connector"))),
			"purpose": trim(to_string(dict_get_or(raw, "purpose", "Provided by an active plugin runtime."))),
			"mode": trim(to_string(dict_get_or(raw, "mode", "plugin_runtime"))), "available": true, "configured": true,
			"enabled": connector_enabled, "status": plugin_status, "endpoint_configured": true, "approval_required": dict_get_or(raw, "approval_required", false),
			"secret_storage": "plugin runtime", "health": "not_checked", "source": "plugin", "source_key": raw["source_key"], "source_name": raw["source_name"], "manageable": true
		})
	}
	return items
}

export mcp_tool_descriptors := func() {
	tools := []
	for ability in ability_registry() {
		parts := split(ability["name"], "/")
		tools = push(tools, {
			"name": parts[0] + "__" + parts[1],
			"title": ability["label"],
			"description": ability["description"],
			"inputSchema": ability["input_schema"],
			"outputSchema": ability["output_schema"],
			"annotations": ability["annotations"],
			"ability": ability["name"],
				"abilityId": ability["definition"]["id"],
				"abilityVersion": ability["definition"]["version"],
				"abilityDigest": ability["definition_digest"],
			"effects": ability["definition"]["effects"],
			"execution": "/v1/abilities/" + parts[0] + "/" + parts[1] + "/run"
		})
	}
	return tools
}

func resolved_mcp_tool_descriptors(ctx) {
	tools := []
	for ability in resolved_ability_registry(ctx) {
		if ability["enabled"] == true {
			parts := split(ability["name"], "/")
			tools = push(tools, {
				"name": parts[0] + "__" + parts[1], "title": ability["label"], "description": ability["description"],
				"inputSchema": ability["input_schema"], "outputSchema": ability["output_schema"], "annotations": ability["annotations"], "ability": ability["name"],
					"abilityId": ability["definition"]["id"], "abilityVersion": ability["definition"]["version"], "abilityDigest": ability["definition_digest"], "effects": ability["definition"]["effects"],
				"execution": "/v1/abilities/" + parts[0] + "/" + parts[1] + "/run"
			})
		}
	}
	return tools
}

func core_connector_endpoint(cfg, connector_key) {
	if connector_key == "ai-sdk" { return trim(to_string(dict_get_or(cfg, "ai_sdk_endpoint", ""))) }
	if connector_key == "agents-sdk" { return trim(to_string(dict_get_or(cfg, "agents_sdk_endpoint", ""))) }
	if connector_key == "mcp" { return trim(to_string(dict_get_or(cfg, "mcp_endpoint", ""))) }
	if connector_key == "dispatch" { return trim(to_string(dict_get_or(cfg, "dispatch_endpoint", ""))) }
	if connector_key == "rag" { return trim(to_string(dict_get_or(cfg, "rag_endpoint", ""))) }
	if connector_key == "redact" { return trim(to_string(dict_get_or(cfg, "redact_endpoint", ""))) }
	if connector_key == "watchdog" { return trim(to_string(dict_get_or(cfg, "watchdog_endpoint", ""))) }
	if connector_key == "contentgraph" { return trim(to_string(dict_get_or(cfg, "contentgraph_endpoint", ""))) }
	if connector_key == "searchbridge" { return trim(to_string(dict_get_or(cfg, "searchbridge_endpoint", ""))) }
	if connector_key == "bluepencil" { return trim(to_string(dict_get_or(cfg, "bluepencil_endpoint", ""))) }
	if connector_key == "presswire" { return trim(to_string(dict_get_or(cfg, "presswire_endpoint", ""))) }
	if connector_key == "readersignal" { return trim(to_string(dict_get_or(cfg, "readersignal_endpoint", ""))) }
	return ""
}

func check_connector_health(ctx, selected) {
	if selected["enabled"] != true { return {"ok": false, "status": 409, "code": "connector_disabled", "message": "Connector is disabled"} }
	endpoint := ""
	if selected["source"] == "plugin" {
		runtime_url := plugin_runtime_url(ctx, selected["source_key"], "/health")
		if runtime_url["ok"] == false { runtime_url["status"] = 422; return runtime_url }
		endpoint = runtime_url["url"]
	} else {
		endpoint = core_connector_endpoint(ctx["cfg"], selected["key"])
		if endpoint == "" { return {"ok": false, "status": 409, "code": "connector_not_configured", "message": "Connector endpoint is not configured"} }
		url_policy := validate_handler_url_policy(ctx["cfg"], endpoint)
		if url_policy["ok"] == false { return {"ok": false, "status": 422, "code": url_policy["code"], "message": url_policy["message"]} }
		while ends_with(endpoint, "/") { endpoint = substring(endpoint, 0, len(endpoint) - 1) }
		endpoint = endpoint + "/health"
	}
	transport_result := http_request(endpoint, {"method": "GET", "timeout": 5.0, "_headers": {"Accept": "application/json", "User-Agent": "Kujo-CMS-Connector-Health/1.0"}})
	match transport_result {
		case Ok(health_response): {
			health_status := to_int(dict_get_or(health_response, "_status", dict_get_or(health_response, "status", 0)))
			if health_status < 200 || health_status > 299 { return {"ok": false, "status": 502, "code": "connector_unhealthy", "message": "Connector health endpoint returned HTTP " + to_string(health_status)} }
			return {"ok": true, "result": {"key": selected["key"], "healthy": true, "status": "healthy", "checked_at": now(), "http_status": health_status}}
		}
		case Err(health_error): { return {"ok": false, "status": 502, "code": "connector_unavailable", "message": "Connector health request failed"} }
		case other: { return {"ok": false, "status": 502, "code": "connector_transport_error", "message": "Connector health request returned an unexpected transport result"} }
	}
}

func run_site_info(ctx) {
	db := ctx["db"]
	counts := {}
	for table_name in ["content_types", "entries", "media_items", "taxonomies", "users"] {
		result := db_query_safe(db, "SELECT COUNT(*) AS total FROM " + table_name, [])
		count_value := null
		if result["ok"] == true { count_value = result["rows"][0]["total"] }
		count_key := table_name
		if table_name == "media_items" { count_key = "media" }
		counts[count_key] := count_value
	}
	cfg := ctx["cfg"]
	return {"service": cfg["service_name"], "version": cfg["service_version"], "site_url": cfg["site_url"], "counts": counts}
}

func run_content_list(ctx, input) {
	limit := to_int(dict_get_or(input, "limit", 20))
	if limit < 1 { limit = 1 }
	if limit > 50 { limit = 50 }
	where_sql := " WHERE 1=1"
	params := []
	query := trim(to_string(dict_get_or(input, "query", "")))
	status := trim(to_string(dict_get_or(input, "status", "")))
	content_type := trim(to_string(dict_get_or(input, "content_type", "")))
	if query != "" { where_sql = where_sql + " AND (title LIKE ? OR slug LIKE ? OR excerpt LIKE ?)"; like := "%" + query + "%"; params = push(params, like); params = push(params, like); params = push(params, like) }
	if status != "" { where_sql = where_sql + " AND status = ?"; params = push(params, status) }
	if content_type != "" { where_sql = where_sql + " AND content_type_key = ?"; params = push(params, content_type) }
	params = push(params, limit)
	result := db_query_safe(ctx["db"], "SELECT id, content_type_key, title, slug, status, excerpt, author_id, published_at, updated_at FROM entries" + where_sql + " ORDER BY updated_at DESC, id DESC LIMIT ?", params)
	if result["ok"] == false { return {"error": "query_failed"} }
	return {"items": result["rows"], "count": len(result["rows"]), "limit": limit}
}

func run_seo_summary(ctx, input) {
	limit := to_int(dict_get_or(input, "limit", 10))
	if limit < 1 { limit = 1 }
	if limit > 50 { limit = 50 }
	title_expr := "trim(CASE WHEN json_valid(meta_json) THEN COALESCE(json_extract(meta_json, '$.seo.title'), '') ELSE '' END)"
	description_expr := "trim(CASE WHEN json_valid(meta_json) THEN COALESCE(json_extract(meta_json, '$.seo.description'), '') ELSE '' END)"
	keyword_expr := "trim(CASE WHEN json_valid(meta_json) THEN COALESCE(json_extract(meta_json, '$.seo.focus_keyword'), '') ELSE '' END)"
	image_expr := "trim(CASE WHEN json_valid(meta_json) THEN COALESCE(json_extract(meta_json, '$.seo.og_image_url'), '') ELSE '' END)"
	rows := db_query_safe(ctx["db"], "SELECT COUNT(*) AS total, SUM(CASE WHEN " + title_expr + " = '' THEN 1 ELSE 0 END) AS missing_titles, SUM(CASE WHEN " + description_expr + " = '' THEN 1 ELSE 0 END) AS missing_descriptions, SUM(CASE WHEN " + keyword_expr + " = '' THEN 1 ELSE 0 END) AS missing_keywords, SUM(CASE WHEN " + image_expr + " = '' THEN 1 ELSE 0 END) AS missing_social_images FROM entries", [])
	priority := db_query_safe(ctx["db"], "SELECT id, content_type_key, title, slug, status, updated_at FROM entries WHERE " + title_expr + " = '' OR " + description_expr + " = '' OR " + keyword_expr + " = '' OR " + image_expr + " = '' ORDER BY updated_at DESC LIMIT ?", [limit])
	summary := {}
	priority_items := []
	if rows["ok"] == true { summary = rows["rows"][0] }
	if priority["ok"] == true { priority_items = priority["rows"] }
	return {"summary": summary, "priority_items": priority_items, "limit": limit}
}

func plugin_runtime_url(ctx, plugin_key, path_value) {
	runtime := extension_plugin_runtime(ctx["db"], plugin_key)
	if runtime["ok"] == false { return runtime }
	service_url := trim(to_string(dict_get_or(runtime["settings"], "service_url", "")))
	if service_url == "" { return {"ok": false, "code": "plugin_runtime_not_configured", "message": "Plugin service_url is not configured"} }
	runtime_policy_cfg := {
		"plugin_hook_allow_http": dict_get_or(ctx["cfg"], "plugin_hook_allow_http", false),
		"plugin_hook_allow_private": dict_get_or(ctx["cfg"], "plugin_runtime_allow_private", false),
		"plugin_hook_url_allowlist": dict_get_or(ctx["cfg"], "plugin_hook_url_allowlist", ""),
		"plugin_hook_url_denylist": dict_get_or(ctx["cfg"], "plugin_hook_url_denylist", "")
	}
	url_policy := validate_handler_url_policy(runtime_policy_cfg, service_url)
	if url_policy["ok"] == false { return {"ok": false, "code": url_policy["code"], "message": url_policy["message"]} }
	path_text := trim(to_string(path_value))
	if starts_with(path_text, "/") == false || contains(path_text, "..") || starts_with(path_text, "//") { return {"ok": false, "code": "invalid_plugin_runtime_path", "message": "Plugin runtime path must be an absolute safe path"} }
	while ends_with(service_url, "/") { service_url = substring(service_url, 0, len(service_url) - 1) }
	return {"ok": true, "url": service_url + path_text, "runtime": runtime}
}

func safe_runtime_component(value) {
	component_text := to_string(value)
	if len(component_text) < 1 || len(component_text) > 512 || regex_replace(component_text, "[A-Za-z0-9_.~-]", "") != "" { return {"ok": false, "value": ""} }
	return {"ok": true, "value": component_text}
}

func plugin_runtime_request(ctx, plugin_key, method_value, path_value, input) {
	method_text := to_upper(trim(to_string(method_value)))
	if method_text != "GET" && method_text != "POST" && method_text != "PUT" && method_text != "PATCH" && method_text != "DELETE" { return {"ok": false, "status": 422, "code": "invalid_plugin_runtime_method", "message": "Plugin ability method is not supported"} }
	if type(input) != "dict" { return {"ok": false, "status": 400, "code": "invalid_input", "message": "Ability input must be an object"} }
	path_text := trim(to_string(path_value))
	path_input_keys := []
	for input_key in keys(input) {
		input_key_text := to_string(input_key)
		placeholder := ":" + input_key_text
		input_value := input[input_key]
		if contains(path_text, placeholder) {
			if type(input_value) != "string" && type(input_value) != "int" && type(input_value) != "float" { return {"ok": false, "status": 400, "code": "invalid_path_parameter", "message": "Plugin path parameters must be scalar values"} }
			path_component := safe_runtime_component(input_value)
			if path_component["ok"] == false { return {"ok": false, "status": 400, "code": "invalid_path_parameter", "message": "Plugin path parameters must use URL-safe characters"} }
			path_text = regex_replace(path_text, placeholder, path_component["value"])
			path_input_keys = push(path_input_keys, input_key_text)
		}
	}
	if contains(path_text, ":") { return {"ok": false, "status": 400, "code": "missing_path_parameter", "message": "Plugin ability input is missing a required path parameter"} }
	url_result := plugin_runtime_url(ctx, plugin_key, path_text)
	if url_result["ok"] == false { url_result["status"] = 422; return url_result }
	plugin_runtime_request_url := url_result["url"]
	runtime_headers := {"Accept": "application/json", "Content-Type": "application/json", "User-Agent": "Kujo-CMS-Plugin-Runtime/1.0"}
	runtime_bearer_env := "CMS_PLUGIN_" + to_upper(regex_replace(plugin_key, "[^a-z0-9]", "_")) + "_BEARER"
	runtime_bearer := trim(env(runtime_bearer_env))
	if runtime_bearer != "" { runtime_headers["Authorization"] := "Bearer " + runtime_bearer }
	request_options := {"method": method_text, "timeout": 10.0, "_headers": runtime_headers}
	if method_text == "GET" {
		plugin_query_separator := "?"
		for query_key in keys(input) {
			query_key_text := to_string(query_key)
			query_value := input[query_key]
			if query_key_text != "confirmed" && contains(path_input_keys, query_key_text) == false && (type(query_value) == "string" || type(query_value) == "int" || type(query_value) == "float" || type(query_value) == "bool") {
				query_key_component := safe_runtime_component(query_key_text)
				query_value_component := safe_runtime_component(query_value)
				if query_key_component["ok"] == false || query_value_component["ok"] == false { return {"ok": false, "status": 400, "code": "invalid_query_parameter", "message": "Plugin query parameters must use URL-safe characters"} }
				plugin_runtime_request_url = plugin_runtime_request_url + plugin_query_separator + query_key_component["value"] + "=" + query_value_component["value"]
				plugin_query_separator = "&"
			}
		}
	} else {
		request_body := {}
		for body_key in keys(input) { body_key_text := to_string(body_key); if body_key_text != "confirmed" && contains(path_input_keys, body_key_text) == false { request_body[body_key_text] := input[body_key] } }
		request_options["_body"] := to_json(request_body)
	}
	transport_result := http_request(plugin_runtime_request_url, request_options)
	match transport_result {
		case Ok(runtime_response): {
			status_code := to_int(dict_get_or(runtime_response, "_status", dict_get_or(runtime_response, "status", 0)))
			response_body := to_string(dict_get_or(runtime_response, "_body", dict_get_or(runtime_response, "body", "")))
			if len(response_body) > 1048576 { return {"ok": false, "status": 502, "code": "plugin_runtime_response_too_large", "message": "Plugin runtime response exceeded 1 MB"} }
			parsed_body := response_body; parse_error := null
			if response_body != "" { try { parsed_body = parse_json(response_body) } except e { parse_error = e } }
			if status_code < 200 || status_code > 299 { return {"ok": false, "status": 502, "code": "plugin_runtime_http_error", "message": "Plugin runtime returned HTTP " + to_string(status_code)} }
			response_format := "text"; if type(parse_error) == "null" { response_format = "json" }
			return {"ok": true, "result": parsed_body, "runtime_status": status_code, "response_format": response_format}
		}
		case Err(runtime_error): { return {"ok": false, "status": 502, "code": "plugin_runtime_unavailable", "message": "Plugin runtime request failed"} }
		case other: { return {"ok": false, "status": 502, "code": "plugin_runtime_transport_error", "message": "Plugin runtime returned an unexpected transport result"} }
	}
}

func execute_cms_ability_handler(req, ctx, ability, input) {
	name := ability["name"]
	if ability["source"] == "plugin" {
		execution := ability["external_execution"]
		return plugin_runtime_request(ctx, ability["source_key"], execution["method"], execution["path"], input)
	}
	if name == "cms/site-info" { return {"ok": true, "result": run_site_info(ctx)} }
	if name == "content/list" { return {"ok": true, "result": run_content_list(ctx, input)} }
	if name == "seo/audit-summary" { return {"ok": true, "result": run_seo_summary(ctx, input)} }
	if name == "ai/integration-status" {
		connectors := resolved_connector_registry(ctx)
		configured := 0
		for item in connectors { if item["configured"] == true { configured = configured + 1 } }
		return {"ok": true, "result": {"connectors": connectors, "configured_count": configured, "ability_count": len(resolved_ability_registry(ctx)), "mcp_tool_count": len(resolved_mcp_tool_descriptors(ctx)), "secrets_exposed": false}}
	}
	if name == "seo/update-entry" {
		entry_id := to_int(dict_get_or(input, "entry_id", 0))
		if entry_id <= 0 { return {"ok": false, "status": 400, "code": "invalid_entry_id", "message": "entry_id must be positive"} }
		normalized := normalize_seo_changes(dict_get_or(input, "changes", {}))
		if normalized["ok"] == false { return {"ok": false, "status": 400, "code": "invalid_seo", "message": normalized["error"]} }
		result := apply_seo_changes(ctx["db"], entry_id, normalized["changes"])
		if result["ok"] == false {
			status_code := 404
			if result["code"] == "entry_locked" { status_code = 409 }
			return {"ok": false, "status": status_code, "code": result["code"], "message": result["message"]}
		}
		return {"ok": true, "result": result}
	}
	if name == "seo/bulk-update" {
		entry_ids := dict_get_or(input, "entry_ids", [])
		if type(entry_ids) != "array" || len(entry_ids) < 1 || len(entry_ids) > 200 { return {"ok": false, "status": 400, "code": "invalid_entry_ids", "message": "entry_ids must contain 1 to 200 IDs"} }
		normalized := normalize_seo_changes(dict_get_or(input, "changes", {}))
		if normalized["ok"] == false { return {"ok": false, "status": 400, "code": "invalid_seo", "message": normalized["error"]} }
		updated_ids := []
		errors := []
		for raw_id in entry_ids {
			entry_id := to_int(raw_id)
			if entry_id <= 0 { errors = push(errors, {"entry_id": raw_id, "code": "invalid_id"}); continue }
			result := apply_seo_changes(ctx["db"], entry_id, normalized["changes"])
			if result["ok"] == true { updated_ids = push(updated_ids, entry_id) } else { errors = push(errors, {"entry_id": entry_id, "code": result["code"]}) }
		}
		return {"ok": true, "result": {"updated_ids": updated_ids, "updated_count": len(updated_ids), "errors": errors}}
	}
	return {"ok": false, "status": 501, "code": "not_implemented", "message": "Ability handler is not implemented"}
}

func cms_ability_runtime_registry(req, ctx, ability) {
	registry := create_ability_registry()
	step := register_ability_definition(registry, ability["definition"])
	if step["ok"] == false { return step }
	registry = step["registry"]
	binding := {
		"schema": "kujo.ability.binding/v1",
		"ability_id": ability["definition"]["id"],
		"ability_version": ability["definition"]["version"],
		"handler_id": "kujo.cms." + regex_replace(ability["name"], "[^a-zA-Z0-9_.-]", "."),
		"handler_version": to_string(dict_get_or(ctx["cfg"], "service_version", "1.0.0")),
		"handler": func(input, runtime_context) { return execute_cms_ability_handler(req, ctx, ability, input) },
		"result_mode": "kujo.result/v1",
		"timeout_ms": 30000,
		"metadata": {"source": ability["source"], "legacy_name": ability["name"]}
	}
	step = register_ability_binding(registry, binding)
	if step["ok"] == false { return step }
	registry = step["registry"]
	exposure := {
		"schema": "kujo.ability.exposure/v1",
		"ability_id": ability["definition"]["id"],
		"ability_version": ability["definition"]["version"],
		"surface": "rest",
		"name": ability["name"],
		"enabled": ability["enabled"],
		"public": false,
		"metadata": {"path": "/v1/abilities/" + ability["name"] + "/run"}
	}
	step = register_ability_exposure(registry, exposure)
	if step["ok"] == false { return step }
	return {"ok": true, "registry": step["registry"], "definition_digest": dict_get_or(step, "digest", "")}
}

func ability_principal(req) {
	auth_context := dict_get_or(req, "auth_context", {})
	tenant_id := "global"
	for permission in dict_get_or(auth_context, "permissions", []) {
		permission_text := trim(to_string(permission))
		if starts_with(permission_text, "tenant:") && len(permission_text) > 7 { tenant_id = substring(permission_text, 7, len(permission_text)) }
	}
	return {
		"type": "cms",
		"id": to_string(dict_get_or(auth_context, "actor", "unknown")),
		"tenant_id": tenant_id,
		"claims": {"role_key": dict_get_or(auth_context, "role_key", ""), "permissions": dict_get_or(auth_context, "permissions", [])}
	}
}

func load_ability_approval(ctx, approval_id, invocation_id) {
	if approval_id == "" { return {"ok": true, "approval": {}} }
	lookup := db_query_safe(ctx["db"], "SELECT approval_json FROM ability_approvals WHERE approval_id = ? AND invocation_id = ? LIMIT 1", [approval_id, invocation_id])
	if lookup["ok"] == false { return {"ok": false, "code": "ability_approval_lookup_failed", "message": "Ability approval lookup failed"} }
	if len(lookup["rows"]) == 0 { return {"ok": false, "code": "ability_approval_not_found", "message": "Ability approval was not found for this invocation"} }
	approval := null; parse_error := null
	try { approval = parse_json(to_string(lookup["rows"][0]["approval_json"])) } except e { parse_error = e }
	if type(parse_error) != "null" || type(approval) != "dict" { return {"ok": false, "code": "ability_approval_invalid", "message": "Stored Ability approval is invalid"} }
	return {"ok": true, "approval": approval}
}

func cms_ability_invocation(req, ctx, ability, input, request_body) {
	request_id := to_string(dict_get_or(req, "request_id", ""))
	if request_id == "" { request_id = substring(sha256(ability["definition"]["id"] + ":" + to_string(current_timestamp())), 0, 24) }
	invocation_id := trim(to_string(dict_get_or(request_body, "invocation_id", "")))
	if invocation_id == "" { invocation_id = "cms-" + request_id }
	approval_id := trim(to_string(dict_get_or(request_body, "approval_id", "")))
	if approval_id == "" { approval_id = trim(to_string(get_header(req, "X-Ability-Approval"))) }
	if approval_id == "" { approval_id = trim(to_string(get_header(req, "x-ability-approval"))) }
	approval_result := load_ability_approval(ctx, approval_id, invocation_id)
	if approval_result["ok"] == false { return approval_result }
	idempotency_context := dict_get_or(req, "idempotency_context", {})
	return {"ok": true, "invocation": {
		"schema": "kujo.ability.invocation/v1",
		"invocation_id": invocation_id,
		"ability_id": ability["definition"]["id"],
		"ability_version": ability["definition"]["version"],
		"definition_digest": ability["definition_digest"],
		"input": input,
		"principal": ability_principal(req),
		"request_id": request_id,
		"trace_id": to_string(dict_get_or(req, "trace_id", request_id)),
		"surface": "rest",
		"idempotency_key": to_string(dict_get_or(idempotency_context, "scoped_key", "")),
		"approval": approval_result["approval"],
		"metadata": {"legacy_name": ability["name"]}
	}}
}

func ensure_ability_approval_request(req, ctx, ability, invocation) {
	binding_digest := approval_binding_digest(invocation)
	now_ms := current_timestamp()
	_ = db_execute_safe(ctx["db"], "DELETE FROM ability_approvals WHERE status = 'requested' AND request_expires_at_ms <= ?", [now_ms])
	write_result := db_execute_safe(ctx["db"], "INSERT OR IGNORE INTO ability_approvals (invocation_id, approval_id, ability_id, ability_version, definition_digest, binding_digest, invocation_json, status, requested_by, approved_by, approval_json, request_expires_at_ms, approval_expires_at_ms, consumed_at_ms, created_at, updated_at) VALUES (?, NULL, ?, ?, ?, ?, ?, 'requested', ?, NULL, NULL, ?, NULL, NULL, ?, ?)", [invocation["invocation_id"], invocation["ability_id"], invocation["ability_version"], invocation["definition_digest"], binding_digest, to_json(invocation), invocation["principal"]["id"], now_ms + 86400000, now(), now()])
	if write_result["ok"] == false { return {"ok": false, "code": "ability_approval_request_failed", "message": "Could not persist Ability approval request"} }
	lookup := db_query_safe(ctx["db"], "SELECT binding_digest, ability_id, ability_version FROM ability_approvals WHERE invocation_id = ? LIMIT 1", [invocation["invocation_id"]])
	if lookup["ok"] == false || len(lookup["rows"]) == 0 { return {"ok": false, "code": "ability_approval_request_failed", "message": "Could not read Ability approval request"} }
	row := lookup["rows"][0]
	if row["binding_digest"] != binding_digest || row["ability_id"] != invocation["ability_id"] || row["ability_version"] != invocation["ability_version"] { return {"ok": false, "code": "ability_approval_request_conflict", "message": "Invocation ID is already bound to a different approval request"} }
	return {"ok": true, "binding_digest": binding_digest}
}

func cms_ability_runtime_services(req, ctx, ability) {
	return {
		"clock_ms": func() { return current_timestamp() },
		"id_factory": func(kind, invocation) { return kind + "-" + substring(sha256(kind + ":" + invocation["invocation_id"] + ":" + invocation["definition_digest"]), 0, 24) },
		"policy": func(definition, invocation, exposure) {
			if dict_get_or(ability["annotations"], "requires_confirmation", false) == true {
				request_result := ensure_ability_approval_request(req, ctx, ability, invocation)
				if request_result["ok"] == false { return {"schema": "kujo.ability.policy-decision/v1", "decision_id": "cms-policy-error-" + substring(sha256(invocation["invocation_id"]), 0, 20), "outcome": "deny", "reason": request_result["message"], "requirements": [request_result["code"]], "policy_id": "kujo.cms.request-bound-approval", "policy_version": "1.0.0"} }
				return {"schema": "kujo.ability.policy-decision/v1", "decision_id": "cms-policy-approval-" + substring(sha256(invocation["invocation_id"]), 0, 20), "outcome": "approval_required", "reason": "This Ability requires a request-bound, one-time approval.", "requirements": [{"kind": "request_bound_approval", "invocation_id": invocation["invocation_id"], "approval_endpoint": "/v1/abilities/" + ability["name"] + "/approvals"}], "policy_id": "kujo.cms.request-bound-approval", "policy_version": "1.0.0"}
			}
			return {"schema": "kujo.ability.policy-decision/v1", "decision_id": "cms-policy-" + substring(sha256(invocation["invocation_id"] + ":" + ability["permission"]), 0, 20), "outcome": "allow", "reason": "CMS request guard authorized the server-owned Ability permission.", "requirements": [], "policy_id": "kujo.cms.request-guard", "policy_version": "1.0.0"}
		},
		"consume_approval": func(approval, invocation) {
			now_ms := current_timestamp()
			consume := db_execute_safe(ctx["db"], "UPDATE ability_approvals SET status = 'consumed', consumed_at_ms = ?, updated_at = ? WHERE invocation_id = ? AND approval_id = ? AND status = 'approved' AND consumed_at_ms IS NULL AND approval_expires_at_ms > ?", [now_ms, now(), invocation["invocation_id"], approval["approval_id"], now_ms])
			if consume["ok"] == false { return {"ok": false} }
			changed := db_query_safe(ctx["db"], "SELECT changes() AS changed", [])
			consumed := false
			if changed["ok"] == true && len(changed["rows"]) > 0 && to_int(changed["rows"][0]["changed"]) == 1 { consumed = true }
			return {"ok": consumed}
		},
		"audit_required": true,
		"audit": func(phase, invocation, payload) {
			action := "ability.preflight"; status_code := 202
			if phase == "completed" { action = "ability.execute"; status_code = 200 }
			_ = write_audit(ctx, req, action, status_code, "ability", ability["name"], {"ability_id": invocation["ability_id"], "ability_version": invocation["ability_version"], "definition_digest": invocation["definition_digest"], "trace_id": invocation["trace_id"], "phase": phase})
			return {"ok": true, "written": true, "phase": phase}
		},
		"begin_idempotency": func(key_digest, request_digest, invocation) { return {"state": "started"} },
		"complete_idempotency": func(key_digest, request_digest, receipt) {
			response_payload := {"ok": true, "data": {"ability": ability["name"], "result": receipt["result"], "receipt": receipt}}
			completion := idempotency_complete(req, ctx, 200, response_payload)
			return {"ok": completion["ok"]}
		}
	}
}

func run_cms_ability_through_runtime(req, ctx, ability, input, request_body) {
	registry_result := cms_ability_runtime_registry(req, ctx, ability)
	if registry_result["ok"] == false { return registry_result }
	invocation_result := cms_ability_invocation(req, ctx, ability, input, request_body)
	if invocation_result["ok"] == false { return invocation_result }
	return execute_ability(registry_result["registry"], invocation_result["invocation"], cms_ability_runtime_services(req, ctx, ability))
}

func issue_ability_approval(req, ctx, ability, invocation_id) {
	now_ms := current_timestamp()
	lookup := db_query_safe(ctx["db"], "SELECT binding_digest, invocation_json, requested_by, request_expires_at_ms, status FROM ability_approvals WHERE invocation_id = ? AND ability_id = ? AND ability_version = ? LIMIT 1", [invocation_id, ability["definition"]["id"], ability["definition"]["version"]])
	if lookup["ok"] == false { return {"ok": false, "status": 500, "code": "ability_approval_lookup_failed", "message": "Could not read Ability approval request"} }
	if len(lookup["rows"]) == 0 { return {"ok": false, "status": 404, "code": "ability_approval_request_not_found", "message": "Ability approval request was not found"} }
	row := lookup["rows"][0]
	if to_int(row["request_expires_at_ms"]) <= now_ms { return {"ok": false, "status": 409, "code": "ability_approval_request_expired", "message": "Ability approval request has expired"} }
	if row["status"] != "requested" { return {"ok": false, "status": 409, "code": "ability_approval_request_resolved", "message": "Ability approval request is no longer pending"} }
	approver := ability_principal(req)
	approval_id := "approval-" + substring(sha256(invocation_id + ":" + approver["id"] + ":" + to_string(now_ms)), 0, 32)
	expires_at_ms := now_ms + 300000
	approval := {
		"schema": ABILITY_APPROVAL_SCHEMA_ID,
		"approval_id": approval_id,
		"binding_digest": row["binding_digest"],
		"approved_by": approver,
		"issued_at_ms": now_ms,
		"expires_at_ms": expires_at_ms,
		"nonce": substring(sha256(approval_id + ":" + to_string(current_timestamp())), 0, 32),
		"evidence": {"source": "cms", "request_id": to_string(dict_get_or(req, "request_id", "")), "requested_by": row["requested_by"]}
	}
	stored_invocation := null; invocation_parse_error := null
	try { stored_invocation = parse_json(to_string(row["invocation_json"])) } except e { invocation_parse_error = e }
	if type(invocation_parse_error) != "null" || type(stored_invocation) != "dict" { return {"ok": false, "status": 500, "code": "ability_approval_request_invalid", "message": "Stored Ability approval request is invalid"} }
	approval_validation := validate_ability_approval(approval, stored_invocation, now_ms)
	if approval_validation["ok"] == false { return {"ok": false, "status": 500, "code": "ability_approval_issue_invalid", "message": "Generated Ability approval is invalid"} }
	write_result := db_execute_safe(ctx["db"], "UPDATE ability_approvals SET approval_id = ?, status = 'approved', approved_by = ?, approval_json = ?, approval_expires_at_ms = ?, updated_at = ? WHERE invocation_id = ? AND status = 'requested'", [approval_id, approver["id"], to_json(approval), expires_at_ms, now(), invocation_id])
	if write_result["ok"] == false { return {"ok": false, "status": 500, "code": "ability_approval_issue_failed", "message": "Could not persist Ability approval"} }
	changed := db_query_safe(ctx["db"], "SELECT changes() AS changed", [])
	if changed["ok"] == false || len(changed["rows"]) == 0 || to_int(changed["rows"][0]["changed"]) != 1 { return {"ok": false, "status": 409, "code": "ability_approval_request_resolved", "message": "Ability approval request is no longer pending"} }
	_ = write_audit(ctx, req, "ability.approval.issue", 201, "ability", ability["name"], {"invocation_id": invocation_id, "approval_id": approval_id, "requested_by": row["requested_by"], "approved_by": approver["id"], "expires_at_ms": expires_at_ms})
	return {"ok": true, "approval_id": approval_id, "invocation_id": invocation_id, "expires_at_ms": expires_at_ms}
}

export register_ability_routes := func(server, ctx) {
	server = server.route("GET", "/v1/abilities/categories", func(req) {
		guard := guard_request(req, ctx, "cms.read")
		if guard["ok"] == false { return guard["response"] }
		return ok(ctx["cfg"], {"items": ability_categories(), "count": len(ability_categories())})
	})
	server = server.route("GET", "/v1/abilities", func(req) {
		guard := guard_request(req, ctx, "cms.read")
		if guard["ok"] == false { return guard["response"] }
		query := dict_get_or(req, "query", {})
		category := trim(to_string(dict_get_or(query, "category", "")))
		items := []
		for ability in resolved_ability_registry(ctx) { if category == "" || ability["category"] == category { items = push(items, ability) } }
		return ok(ctx["cfg"], {"items": items, "count": len(items), "categories": ability_categories()})
	})
		server = server.route("GET", "/v1/abilities/definitions", func(req) {
		guard := guard_request(req, ctx, "cms.read")
		if guard["ok"] == false { return guard["response"] }
		definitions := []
		digests := {}
		for ability in resolved_ability_registry(ctx) {
			definition_result := validate_ability_definition(ability["definition"])
			if definition_result["ok"] == false { return fail(ctx["cfg"], 500, "invalid_ability_definition", "Registered Ability definition is invalid", {"ability": ability["name"], "reason": definition_result["code"]}) }
			definitions = push(definitions, ability["definition"])
			digests[ability["definition"]["id"] + "@" + ability["definition"]["version"]] := ability["definition_digest"]
		}
		return ok(ctx["cfg"], {"schema": ABILITY_SCHEMA_ID, "items": definitions, "digests": digests, "count": len(definitions)})
	})
	server = server.route("GET", "/v1/abilities/:namespace/:ability", func(req) {
		params := dict_get_or(req, "params", {})
		ability := find_resolved_ability(ctx, dict_get_or(params, "namespace", ""), dict_get_or(params, "ability", ""))
		if type(ability) == "null" { return fail(ctx["cfg"], 404, "ability_not_found", "Ability not found", {}) }
		guard := guard_request(req, ctx, ability["permission"])
		if guard["ok"] == false { return guard["response"] }
		return ok(ctx["cfg"], ability)
	})
	server = server.route("POST", "/v1/abilities/:namespace/:ability/run", func(req) {
		params := dict_get_or(req, "params", {})
		ability := find_resolved_ability(ctx, dict_get_or(params, "namespace", ""), dict_get_or(params, "ability", ""))
		if type(ability) == "null" { return fail(ctx["cfg"], 404, "ability_not_found", "Ability not found", {}) }
		if ability["enabled"] != true { return fail(ctx["cfg"], 409, "ability_disabled", "Ability is disabled by an administrator", {}) }
		guard := guard_request(req, ctx, ability["permission"])
		if guard["ok"] == false { return guard["response"] }
		req["auth_context"] := guard["auth"]
		req["idempotency_context"] := dict_get_or(guard, "idempotency_context", {})
		body_result := parse_json_body(req, ctx["cfg"])
		if body_result["ok"] == false { return fail(ctx["cfg"], 400, "invalid_body", body_result["error"], {}) }
		input := dict_get_or(body_result["data"], "input", {})
		if type(input) != "dict" { return fail(ctx["cfg"], 400, "invalid_input", "input must be an object", {}) }
		input_result := validate_ability_invocation(ability, input)
		if input_result["ok"] == false {
			return fail(ctx["cfg"], 400, input_result["code"], input_result["message"], input_result["details"])
		}
		runtime_result := run_cms_ability_through_runtime(req, ctx, ability, input, body_result["data"])
		if has_key(runtime_result, "receipt") == 0 {
			idempotency_context := dict_get_or(req, "idempotency_context", {})
			scoped_key := to_string(dict_get_or(idempotency_context, "scoped_key", ""))
			if scoped_key != "" { _ = db_execute_safe(ctx["db"], "DELETE FROM idempotency_keys WHERE idempotency_key = ? AND status = 'pending'", [scoped_key]) }
			runtime_status := 500
			runtime_code := dict_get_or(runtime_result, "code", "ability_runtime_failed")
			if runtime_code == "ability_approval_not_found" || runtime_code == "ability_approval_invalid" { runtime_status = 400 }
			if runtime_code == "ability_approval_replayed" || runtime_code == "ability_approval_expired" || runtime_code == "ability_approval_binding_mismatch" { runtime_status = 409 }
			return fail(ctx["cfg"], runtime_status, runtime_code, dict_get_or(runtime_result, "message", "Ability runtime failed"), dict_get_or(runtime_result, "details", {}))
		}
		receipt := runtime_result["receipt"]
		if receipt["status"] != "succeeded" {
			error_value := dict_get_or(receipt, "error", {})
			error_details := dict_get_or(error_value, "details", {})
			error_code := dict_get_or(error_value, "code", "ability_execution_failed")
			status_code := to_int(dict_get_or(error_details, "http_status", 500))
			if receipt["status"] == "rejected" { status_code = 403 }
			if error_code == "ability_input_invalid" || error_code == "ability_idempotency_key_required" { status_code = 400 }
			if error_code == "ability_approval_replayed" || error_code == "ability_approval_expired" || error_code == "ability_approval_binding_mismatch" || error_code == "ability_invocation_in_progress" || error_code == "ability_idempotency_conflict" { status_code = 409 }
			if receipt["status"] == "approval_required" {
				status_code = 409
				idempotency_context := dict_get_or(req, "idempotency_context", {})
				scoped_key := to_string(dict_get_or(idempotency_context, "scoped_key", ""))
				if scoped_key != "" { _ = db_execute_safe(ctx["db"], "DELETE FROM idempotency_keys WHERE idempotency_key = ? AND status = 'pending'", [scoped_key]) }
			}
			if receipt["status"] == "timed_out" { status_code = 504 }
			if receipt["status"] == "cancelled" { status_code = 409 }
			return fail(ctx["cfg"], status_code, error_code, dict_get_or(error_value, "message", "Ability execution failed"), {"receipt": receipt})
		}
		response_data := {"ability": ability["name"], "result": receipt["result"], "receipt": receipt}
		if ability["definition"]["idempotency"]["mode"] != "keyed" { _ = idempotency_complete(req, ctx, 200, {"ok": true, "data": response_data}) }
		return ok(ctx["cfg"], response_data)
	})
	server = server.route("POST", "/v1/abilities/:namespace/:ability/approvals", func(req) {
		params := dict_get_or(req, "params", {})
		ability := find_resolved_ability(ctx, dict_get_or(params, "namespace", ""), dict_get_or(params, "ability", ""))
		if type(ability) == "null" { return fail(ctx["cfg"], 404, "ability_not_found", "Ability not found", {}) }
		if dict_get_or(ability["annotations"], "requires_confirmation", false) != true { return fail(ctx["cfg"], 409, "ability_approval_not_required", "Ability does not require approval", {}) }
		guard := guard_request(req, ctx, "admin.settings")
		if guard["ok"] == false { return guard["response"] }
		req["auth_context"] := guard["auth"]
		body_result := parse_json_body(req, ctx["cfg"])
		if body_result["ok"] == false { return fail(ctx["cfg"], 400, "invalid_body", body_result["error"], {}) }
		invocation_id := trim(to_string(dict_get_or(body_result["data"], "invocation_id", "")))
		if invocation_id == "" || len(invocation_id) > 240 { return fail(ctx["cfg"], 400, "invalid_ability_invocation_id", "invocation_id is required and must be at most 240 characters", {}) }
		result := issue_ability_approval(req, ctx, ability, invocation_id)
		if result["ok"] == false { return fail(ctx["cfg"], result["status"], result["code"], result["message"], {}) }
		return created(ctx["cfg"], result)
	})
	server = server.route("PATCH", "/v1/abilities/:namespace/:ability", func(req) {
		guard := guard_request(req, ctx, "admin.settings")
		if guard["ok"] == false { return guard["response"] }
		params := dict_get_or(req, "params", {})
		ability := find_resolved_ability(ctx, dict_get_or(params, "namespace", ""), dict_get_or(params, "ability", ""))
		if type(ability) == "null" { return fail(ctx["cfg"], 404, "ability_not_found", "Ability not found", {}) }
		if ability["manageable"] != true { return fail(ctx["cfg"], 409, "plugin_managed", "Activate or deactivate the plugin to change this ability", {}) }
		body_result := parse_json_body(req, ctx["cfg"])
		if body_result["ok"] == false { return fail(ctx["cfg"], 400, "invalid_body", body_result["error"], {}) }
		body := body_result["data"]
		if type(body) != "dict" || type(dict_get_or(body, "enabled", null)) != "bool" { return fail(ctx["cfg"], 400, "invalid_enabled", "enabled must be a boolean", {}) }
		enabled := body["enabled"]
		write_result := set_feature_state(ctx["db"], "ability", ability["name"], enabled)
		if write_result["ok"] == false { return fail(ctx["cfg"], 500, "ability_state_failed", "Could not update ability state", {}) }
		_ = write_audit(ctx, req, "ability.state.update", 200, "ability", ability["name"], {"enabled": enabled})
		updated := find_resolved_ability(ctx, dict_get_or(params, "namespace", ""), dict_get_or(params, "ability", ""))
		return ok(ctx["cfg"], updated)
	})
	server = server.route("GET", "/v1/ai/connectors", func(req) {
		guard := guard_request(req, ctx, "admin.settings")
		if guard["ok"] == false { return guard["response"] }
		items := resolved_connector_registry(ctx)
		return ok(ctx["cfg"], {"items": items, "count": len(items), "secrets_exposed": false})
	})
	server = server.route("PATCH", "/v1/ai/connectors/:key", func(req) {
		guard := guard_request(req, ctx, "admin.settings")
		if guard["ok"] == false { return guard["response"] }
		connector_key := trim(to_string(dict_get_or(dict_get_or(req, "params", {}), "key", "")))
		selected := null
		for item in resolved_connector_registry(ctx) { if item["key"] == connector_key { selected = item } }
		if type(selected) == "null" { return fail(ctx["cfg"], 404, "connector_not_found", "Connector not found", {}) }
		if selected["manageable"] != true { return fail(ctx["cfg"], 409, "plugin_managed", "Activate or deactivate the plugin to change this connector", {}) }
		body_result := parse_json_body(req, ctx["cfg"])
		if body_result["ok"] == false { return fail(ctx["cfg"], 400, "invalid_body", body_result["error"], {}) }
		body := body_result["data"]
		if type(body) != "dict" || type(dict_get_or(body, "enabled", null)) != "bool" { return fail(ctx["cfg"], 400, "invalid_enabled", "enabled must be a boolean", {}) }
		enabled := body["enabled"]
		if enabled == true && selected["configured"] != true { return fail(ctx["cfg"], 409, "connector_not_configured", "Configure the connector endpoint before activating it", {}) }
		write_result := set_feature_state(ctx["db"], "connector", connector_key, enabled)
		if write_result["ok"] == false { return fail(ctx["cfg"], 500, "connector_state_failed", "Could not update connector state", {}) }
		_ = write_audit(ctx, req, "connector.state.update", 200, "connector", connector_key, {"enabled": enabled})
		updated := null; for item in resolved_connector_registry(ctx) { if item["key"] == connector_key { updated = item } }
		return ok(ctx["cfg"], updated)
	})
	server = server.route("POST", "/v1/ai/connectors/:key/health", func(req) {
		guard := guard_request(req, ctx, "admin.settings")
		if guard["ok"] == false { return guard["response"] }
		connector_key := trim(to_string(dict_get_or(dict_get_or(req, "params", {}), "key", "")))
		selected := null
		for item in resolved_connector_registry(ctx) { if item["key"] == connector_key { selected = item } }
		if type(selected) == "null" { return fail(ctx["cfg"], 404, "connector_not_found", "Connector not found", {}) }
		health_result := check_connector_health(ctx, selected)
		if health_result["ok"] == false { return fail(ctx["cfg"], health_result["status"], health_result["code"], health_result["message"], {}) }
		_ = write_audit(ctx, req, "connector.health.check", 200, "connector", connector_key, {"healthy": true})
		return ok(ctx["cfg"], health_result["result"])
	})
	server = server.route("GET", "/v1/ai/mcp/tools", func(req) {
		guard := guard_request(req, ctx, "cms.read")
		if guard["ok"] == false { return guard["response"] }
		tools := resolved_mcp_tool_descriptors(ctx)
		return ok(ctx["cfg"], {"tools": tools, "count": len(tools), "protocol": "mcp-ready", "transport": "CMS REST abilities"})
	})
	return server
}

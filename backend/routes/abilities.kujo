func core_ability_definition(ability) {
	legacy_name := ability["name"]
	canonical_id := ""
	resource := ""
	effect_kind := "read"
	idempotency_mode := "intrinsic"
	if legacy_name == "cms/site-info" { canonical_id = "kujo.cms.site.inspect"; resource = "kujo.cms.site" }
	if legacy_name == "content/list" { canonical_id = "kujo.cms.content.list"; resource = "kujo.cms.content" }
	if legacy_name == "seo/audit-summary" { canonical_id = "kujo.cms.seo.audit"; resource = "kujo.cms.seo" }
	if legacy_name == "seo/update-entry" { canonical_id = "kujo.cms.seo.update-entry"; resource = "kujo.cms.seo"; effect_kind = "write"; idempotency_mode = "keyed" }
	if legacy_name == "seo/bulk-update" { canonical_id = "kujo.cms.seo.bulk-update"; resource = "kujo.cms.seo"; effect_kind = "write"; idempotency_mode = "keyed" }
	if legacy_name == "ai/integration-status" { canonical_id = "kujo.cms.integrations.inspect"; resource = "kujo.cms.integrations" }
	return {
		"schema": ABILITY_SCHEMA_ID,
		"id": canonical_id,
		"version": "1.0.0",
		"title": ability["label"],
		"description": ability["description"],
		"input_schema": ability["input_schema"],
		"output_schema": ability["output_schema"],
		"effects": [{"kind": effect_kind, "resource": resource}],
		"idempotency": {"mode": idempotency_mode}
	}
}

export ability_registry := func() {
	items := [
		{
			"name": "cms/site-info", "label": "Get site information", "description": "Return CMS identity, version, site URL, and aggregate resource counts.", "category": "cms", "permission": "cms.read",
			"input_schema": {"type": "object", "additionalProperties": false},
			"output_schema": {"type": "object", "required": ["service", "version", "site_url", "counts"], "properties": {"service": {"type": "string"}, "version": {"type": "string"}, "site_url": {"type": "string"}, "counts": {"type": "object"}}, "additionalProperties": false},
			"annotations": {"readonly": true, "destructive": false, "idempotent": true, "requires_confirmation": false}
		},
		{
			"name": "content/list", "label": "List content", "description": "Search a bounded page of content without exposing arbitrary SQL or filesystem access.", "category": "content", "permission": "cms.read",
			"input_schema": {"type": "object", "properties": {"query": {"type": "string", "maxLength": 200}, "status": {"type": "string", "maxLength": 40}, "content_type": {"type": "string", "maxLength": 80}, "limit": {"type": "integer", "minimum": 1, "maximum": 50}}, "additionalProperties": false},
			"output_schema": {"type": "object", "required": ["items", "count", "limit"], "properties": {"items": {"type": "array", "items": {"type": "object"}}, "count": {"type": "integer", "minimum": 0}, "limit": {"type": "integer", "minimum": 1, "maximum": 50}}, "additionalProperties": false},
			"annotations": {"readonly": true, "destructive": false, "idempotent": true, "requires_confirmation": false}
		},
		{
			"name": "seo/audit-summary", "label": "Get SEO audit summary", "description": "Return aggregate SEO coverage and the highest-priority entries needing work.", "category": "seo", "permission": "cms.read",
			"input_schema": {"type": "object", "properties": {"limit": {"type": "integer", "minimum": 1, "maximum": 50}}, "additionalProperties": false},
			"output_schema": {"type": "object", "required": ["summary", "priority_items", "limit"], "properties": {"summary": {"type": "object"}, "priority_items": {"type": "array", "items": {"type": "object"}}, "limit": {"type": "integer", "minimum": 1, "maximum": 50}}, "additionalProperties": false},
			"annotations": {"readonly": true, "destructive": false, "idempotent": true, "requires_confirmation": false}
		},
		{
			"name": "seo/update-entry", "label": "Update entry SEO", "description": "Apply validated SEO metadata to one unlocked entry.", "category": "seo", "permission": "cms.write",
			"input_schema": {"type": "object", "required": ["entry_id", "changes"], "properties": {"entry_id": {"type": "integer", "minimum": 1}, "changes": {"type": "object"}, "confirmed": {"type": "boolean", "const": true}}, "additionalProperties": false},
			"output_schema": {"type": "object", "required": ["ok", "entry_id", "seo"], "properties": {"ok": {"type": "boolean", "const": true}, "entry_id": {"type": "integer", "minimum": 1}, "seo": {"type": "object"}}, "additionalProperties": false},
			"annotations": {"readonly": false, "destructive": false, "idempotent": true, "requires_confirmation": true}
		},
		{
			"name": "seo/bulk-update", "label": "Bulk update entry SEO", "description": "Apply the same validated SEO metadata to as many as 200 selected entries.", "category": "seo", "permission": "cms.write",
			"input_schema": {"type": "object", "required": ["entry_ids", "changes"], "properties": {"entry_ids": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"type": "integer", "minimum": 1}}, "changes": {"type": "object"}, "confirmed": {"type": "boolean", "const": true}}, "additionalProperties": false},
			"output_schema": {"type": "object", "required": ["updated_ids", "updated_count", "errors"], "properties": {"updated_ids": {"type": "array", "items": {"type": "integer", "minimum": 1}}, "updated_count": {"type": "integer", "minimum": 0}, "errors": {"type": "array", "items": {"type": "object"}}}, "additionalProperties": false},
			"annotations": {"readonly": false, "destructive": false, "idempotent": true, "requires_confirmation": true}
		},
		{
			"name": "ai/integration-status", "label": "Get AI integration status", "description": "Return the installed Kujo integration surface without exposing connector secrets.", "category": "ai", "permission": "admin.settings",
			"input_schema": {"type": "object", "additionalProperties": false},
			"output_schema": {"type": "object", "required": ["connectors", "configured_count", "ability_count", "mcp_tool_count", "secrets_exposed"], "properties": {"connectors": {"type": "array", "items": {"type": "object"}}, "configured_count": {"type": "integer", "minimum": 0}, "ability_count": {"type": "integer", "minimum": 0}, "mcp_tool_count": {"type": "integer", "minimum": 0}, "secrets_exposed": {"type": "boolean", "const": false}}, "additionalProperties": false},
			"annotations": {"readonly": true, "destructive": false, "idempotent": true, "requires_confirmation": false}
		}
	]
	resolved := []
	for ability in items {
		ability["definition"] := core_ability_definition(ability)
		digest_result := ability_definition_digest(ability["definition"])
		ability["definition_digest"] := dict_get_or(digest_result, "digest", "")
		resolved = push(resolved, ability)
	}
	return resolved
}

export ability_definitions := func() {
	definitions := []
	for ability in ability_registry() { definitions = push(definitions, ability["definition"]) }
	return definitions
}

func feature_state(db, feature_type, feature_key, default_enabled) {
	setting_key := "ai." + feature_type + "." + feature_key + ".enabled"
	result := db_query_safe(db, "SELECT setting_value FROM settings WHERE setting_key = ? LIMIT 1", [setting_key])
	if result["ok"] == false || len(result["rows"]) == 0 { return default_enabled }
	return to_lower(trim(to_string(result["rows"][0]["setting_value"]))) == "true"
}

func set_feature_state(db, feature_type, feature_key, enabled) {
	setting_key := "ai." + feature_type + "." + feature_key + ".enabled"
	value := "false"; if enabled == true { value = "true" }
	return db_execute_safe(db, "INSERT INTO settings (setting_key, setting_value, updated_at) VALUES (?, ?, ?) ON CONFLICT(setting_key) DO UPDATE SET setting_value = excluded.setting_value, updated_at = excluded.updated_at", [setting_key, value, now()])
}

export resolved_ability_registry := func(ctx) {
	items := []
	for ability in ability_registry() {
		ability["enabled"] := feature_state(ctx["db"], "ability", ability["name"], true)
		ability["source"] := "core"
		ability["manageable"] := true
		items = push(items, ability)
	}
	registry := extension_ai_registry(ctx["db"])
	for raw in registry["abilities"] {
		raw_name := to_lower(trim(to_string(dict_get_or(raw, "name", "plugin.ability"))))
		name_parts := split(raw_name, ".")
		namespace := regex_replace(name_parts[0], "[^a-z0-9_-]", "-")
		external_name := regex_replace(regex_replace(raw_name, "^[^.]+\\.", ""), "[^a-z0-9_-]", "-")
		method := to_upper(trim(to_string(dict_get_or(raw, "method", "GET"))))
		readonly := method == "GET"
		input_schema := dict_get_or(raw, "input_schema", {"type": "object"})
		output_schema := dict_get_or(raw, "output_schema", {"type": "object"})
		label := trim(to_string(dict_get_or(raw, "label", raw_name)))
		description := trim(to_string(dict_get_or(raw, "description", "Provided by an active plugin runtime.")))
		plugin_resource := "kujo.plugin." + raw["source_key"] + "." + namespace
		plugin_effect := "write"; plugin_idempotency := "none"
		if readonly { plugin_effect = "read"; plugin_idempotency = "intrinsic" }
		definition := {
			"schema": ABILITY_SCHEMA_ID, "id": "kujo.plugin." + raw["source_key"] + "." + raw_name, "version": "1.0.0",
			"title": label, "description": description, "input_schema": input_schema, "output_schema": output_schema,
			"effects": [{"kind": plugin_effect, "resource": plugin_resource}], "idempotency": {"mode": plugin_idempotency}
		}
		digest_result := ability_definition_digest(definition)
		qualified_plugin_name := "plugin-" + raw["source_key"] + "/" + namespace + "-" + external_name
		items = push(items, {
			"name": qualified_plugin_name, "label": trim(to_string(dict_get_or(raw, "label", raw_name))),
			"description": description,
			"category": "plugin", "permission": trim(to_string(dict_get_or(raw, "permission", "admin.plugins"))),
			"input_schema": input_schema, "output_schema": output_schema, "definition": definition, "definition_digest": dict_get_or(digest_result, "digest", ""),
			"annotations": {"readonly": readonly, "destructive": false, "idempotent": false, "requires_confirmation": readonly == false},
			"enabled": feature_state(ctx["db"], "ability", qualified_plugin_name, true), "source": "plugin", "source_key": raw["source_key"], "source_name": raw["source_name"], "manageable": true,
			"external_execution": {"method": method, "path": trim(to_string(dict_get_or(raw, "path", ""))), "runtime": "plugin"}
		})
	}
	return items
}

export find_ability := func(namespace, ability_name) {
	qualified_name := trim(to_string(namespace)) + "/" + trim(to_string(ability_name))
	for ability in ability_registry() {
		if ability["name"] == qualified_name { return ability }
	}
	return null
}

func find_resolved_ability(ctx, namespace, ability_name) {
	qualified_name := trim(to_string(namespace)) + "/" + trim(to_string(ability_name))
	for ability in resolved_ability_registry(ctx) {
		if ability["name"] == qualified_name { return ability }
	}
	return null
}

func connector(cfg, key, label, purpose, mode, endpoint_key, approval_required) {
	endpoint := trim(to_string(dict_get_or(cfg, endpoint_key, "")))
	configured := endpoint != ""
	status := "available"
	health := "not_configured"
	if configured == true { status = "configured"; health = "not_checked" }
	return {
		"key": key, "label": label, "purpose": purpose, "mode": mode,
		"available": true, "configured": configured, "status": status,
		"endpoint_configured": configured, "approval_required": approval_required,
		"secret_storage": "external", "health": health
	}
}


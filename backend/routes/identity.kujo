from backend.core.database import db_execute_safe, db_query_safe
from backend.core.http import created, fail, get_header, guard_request, ok, parse_json_body, write_audit
from backend.core.utils import dict_get_or, is_valid_slug_key
from backend.modules.auth import effective_admin_capabilities

func identity_user_columns() {
	return "u.id, u.user_key, u.email, u.username, u.display_name, u.first_name, u.last_name, u.bio, u.website_url, u.avatar_url, u.social_json, u.role_key, u.status, u.email_verified_at, u.approved_at, u.approved_by, u.last_login_at, u.created_at, u.updated_at, r.name AS role_name, r.permissions_json"
}

func valid_email(email) {
	return len(email) >= 5 && len(email) <= 254 && contains(email, "@") > 0 && contains(email, ".") > 0
}

func identity_payload(row) {
	permissions := []
	err := null
	try { permissions = parse_json(to_string(dict_get_or(row, "permissions_json", "[]"))) } except e { err = e }
	if type(err) != "null" || type(permissions) != "array" { permissions = [] }
	return {
		"id": row["id"], "user_key": row["user_key"], "email": row["email"], "username": row["username"],
		"display_name": row["display_name"], "first_name": row["first_name"], "last_name": row["last_name"],
		"bio": row["bio"], "website_url": row["website_url"], "avatar_url": row["avatar_url"], "social_json": row["social_json"],
		"role_key": row["role_key"], "role_name": row["role_name"], "status": row["status"],
		"email_verified_at": row["email_verified_at"], "approved_at": row["approved_at"], "approved_by": row["approved_by"],
		"last_login_at": row["last_login_at"], "created_at": row["created_at"], "updated_at": row["updated_at"],
		"permissions": permissions, "capabilities": effective_admin_capabilities(permissions)
	}
}

func load_identity_user(db, user_id) {
	result := db_query_safe(db, "SELECT " + identity_user_columns() + " FROM users u INNER JOIN roles r ON r.role_key = u.role_key WHERE u.id = ? LIMIT 1", [user_id])
	if result["ok"] == false { return {"ok": false, "code": "db_query_failed", "message": "Failed to load identity"} }
	if len(result["rows"]) == 0 { return {"ok": false, "code": "user_not_found", "message": "User not found"} }
	return {"ok": true, "row": result["rows"][0], "user": identity_payload(result["rows"][0])}
}

func issue_identity_session(db, user_id, provider, provider_subject, ttl_seconds) {
	if ttl_seconds < 300 { ttl_seconds = 300 }
	if ttl_seconds > 86400 { ttl_seconds = 86400 }
	token := "cms_session_" + regex_replace(uuid_v4() + uuid_v4(), "-", "")
	expires_at := current_timestamp() + (ttl_seconds * 1000)
	result := db_execute_safe(db, "INSERT INTO identity_sessions (token_hash, user_id, provider, provider_subject, expires_at, last_seen_at, revoked_at, created_at) VALUES (?, ?, ?, ?, ?, ?, NULL, ?)", [sha256(token), user_id, provider, provider_subject, expires_at, now(), now()])
	if result["ok"] == false { return {"ok": false, "code": "session_create_failed", "message": "Could not create identity session"} }
	return {"ok": true, "token": token, "expires_at": expires_at, "ttl_seconds": ttl_seconds, "provider": provider}
}

func provider_exchange(req, ctx) {
	cfg := ctx["cfg"]
	body_result := parse_json_body(req, cfg)
	if body_result["ok"] == false { return fail(cfg, 400, "invalid_body", body_result["error"], {}) }
	body := body_result["data"]
	provider := to_lower(trim(to_string(dict_get_or(body, "provider", ""))))
	provider_subject := trim(to_string(dict_get_or(body, "provider_subject", "")))
	if is_valid_slug_key(provider) == false || len(provider) > 64 || len(provider_subject) < 1 || len(provider_subject) > 256 {
		return fail(cfg, 400, "invalid_provider_identity", "provider and provider_subject are required", {})
	}

	linked := db_query_safe(ctx["db"], "SELECT user_id FROM identity_links WHERE provider = ? AND provider_subject = ? LIMIT 1", [provider, provider_subject])
	if linked["ok"] == false { return fail(cfg, 500, "identity_lookup_failed", "Could not resolve provider identity", {}) }
	user_id := 0
	if len(linked["rows"]) > 0 { user_id = to_int(linked["rows"][0]["user_id"]) }
	if user_id <= 0 {
		requested_user_id := to_int(dict_get_or(body, "user_id", 0))
		if requested_user_id > 0 { user_id = requested_user_id }
	}
	if user_id <= 0 {
		email := to_lower(trim(to_string(dict_get_or(body, "email", ""))))
		if valid_email(email) { rows := db_query_safe(ctx["db"], "SELECT id FROM users WHERE lower(email) = ? LIMIT 1", [email]); if rows["ok"] == true && len(rows["rows"]) > 0 { user_id = rows["rows"][0]["id"] } }
	}
	if user_id <= 0 && dict_get_or(body, "create_user", false) == true {
		email := to_lower(trim(to_string(dict_get_or(body, "email", ""))))
		display_name := trim(to_string(dict_get_or(body, "display_name", "")))
		username := to_lower(trim(to_string(dict_get_or(body, "username", ""))))
		username = regex_replace(regex_replace(username, "[^a-z0-9-]+", "-"), "^-+|-+$", "")
		if valid_email(email) == false || len(display_name) < 2 || len(username) < 3 || len(username) > 64 { return fail(cfg, 400, "invalid_provider_user", "A valid email, username, and display_name are required to create a provider user", {}) }
		settings := {"mode": "approval", "default_role": "subscriber"}
		settings_rows := db_query_safe(ctx["db"], "SELECT setting_value FROM settings WHERE setting_key = 'user_registration' LIMIT 1", [])
		if settings_rows["ok"] == true && len(settings_rows["rows"]) > 0 { parse_err := null; try { settings = parse_json(settings_rows["rows"][0]["setting_value"]) } except e { parse_err = e }; if type(parse_err) != "null" || type(settings) != "dict" { settings = {"mode": "approval", "default_role": "subscriber"} } }
		status := "pending"; approved_by := ""; approved_at := null
		if dict_get_or(settings, "mode", "approval") == "open" { status = "active"; approved_by = "provider:" + provider; approved_at = now() }
		if dict_get_or(settings, "mode", "approval") == "closed" { return fail(cfg, 403, "registration_closed", "Provider registration is closed", {}) }
		salt := regex_replace(uuid_v4(), "-", "")
		credential := sha256(uuid_v4() + ":" + salt)
		inserted := db_execute_safe(ctx["db"], "INSERT INTO users (user_key, email, username, display_name, first_name, last_name, bio, website_url, avatar_url, social_json, role_key, status, password_hash, password_salt, password_iterations, email_verified_at, approved_at, approved_by, last_login_at, created_at, updated_at) VALUES (?, ?, ?, ?, '', '', '', '', '', '{}', ?, ?, ?, ?, 210000, ?, ?, ?, NULL, ?, ?)", [username, email, username, display_name, dict_get_or(settings, "default_role", "subscriber"), status, credential, salt, now(), approved_at, approved_by, now(), now()])
		if inserted["ok"] == false { return fail(cfg, 409, "provider_user_create_failed", "Could not create provider user", {}) }
		user_id = db_last_insert_id(ctx["db"])
	}
	if user_id <= 0 { return fail(cfg, 404, "provider_identity_unmapped", "Provider identity is not linked to a CMS user", {}) }
	user_result := load_identity_user(ctx["db"], user_id)
	if user_result["ok"] == false { return fail(cfg, 404, user_result["code"], user_result["message"], {}) }
	link_result := db_execute_safe(ctx["db"], "INSERT INTO identity_links (user_id, provider, provider_subject, created_at, updated_at) VALUES (?, ?, ?, ?, ?) ON CONFLICT(provider, provider_subject) DO UPDATE SET user_id = excluded.user_id, updated_at = excluded.updated_at", [user_id, provider, provider_subject, now(), now()])
	if link_result["ok"] == false { return fail(cfg, 409, "identity_link_failed", "Could not link provider identity", {}) }
	if user_result["row"]["status"] != "active" { return ok(cfg, {"authenticated": false, "pending": user_result["row"]["status"] == "pending", "user": user_result["user"]}) }
	session := issue_identity_session(ctx["db"], user_id, provider, provider_subject, to_int(dict_get_or(body, "ttl_seconds", 28800)))
	if session["ok"] == false { return fail(cfg, 500, session["code"], session["message"], {}) }
	_ = db_execute_safe(ctx["db"], "UPDATE users SET last_login_at = ?, updated_at = ? WHERE id = ?", [now(), now(), user_id])
	_ = write_audit(ctx, req, "identity.provider.exchange", 200, "user", user_id, {"provider": provider})
	return ok(cfg, {"authenticated": true, "user": user_result["user"], "session": session})
}

export register_identity_routes := func(server, ctx) {
	server = server.route("POST", "/v1/auth/sessions", func(req) {
		guard := guard_request(req, ctx, "admin.users"); if guard["ok"] == false { return guard["response"] }
		body_result := parse_json_body(req, ctx["cfg"]); if body_result["ok"] == false { return fail(ctx["cfg"], 400, "invalid_body", body_result["error"], {}) }
		body := body_result["data"]; user_id := to_int(dict_get_or(body, "user_id", 0)); provider := to_lower(trim(to_string(dict_get_or(body, "provider", "password")))); provider_subject := trim(to_string(dict_get_or(body, "provider_subject", to_string(user_id))))
		if user_id <= 0 || is_valid_slug_key(provider) == false || len(provider) > 64 || len(provider_subject) < 1 || len(provider_subject) > 256 { return fail(ctx["cfg"], 400, "invalid_session_identity", "A valid user_id, provider, and provider_subject are required", {}) }
		user_result := load_identity_user(ctx["db"], user_id); if user_result["ok"] == false { return fail(ctx["cfg"], 404, user_result["code"], user_result["message"], {}) }
		if user_result["row"]["status"] != "active" { return fail(ctx["cfg"], 409, "user_inactive", "Only active users can receive sessions", {}) }
		session := issue_identity_session(ctx["db"], user_id, provider, provider_subject, to_int(dict_get_or(body, "ttl_seconds", 28800))); if session["ok"] == false { return fail(ctx["cfg"], 500, session["code"], session["message"], {}) }
		_ = db_execute_safe(ctx["db"], "UPDATE users SET last_login_at = ?, updated_at = ? WHERE id = ?", [now(), now(), user_id])
		_ = write_audit(ctx, req, "identity.session.create", 201, "user", user_id, {"provider": provider, "ttl_seconds": session["ttl_seconds"]})
		return created(ctx["cfg"], {"user": user_result["user"], "session": session})
	})
	server = server.route("POST", "/v1/auth/providers/exchange", func(req) { guard := guard_request(req, ctx, "admin.users"); if guard["ok"] == false { return guard["response"] }; return provider_exchange(req, ctx) })
	server = server.route("GET", "/v1/auth/me", func(req) {
		guard := guard_request(req, ctx, "auth.session"); if guard["ok"] == false { return guard["response"] }
		user_result := load_identity_user(ctx["db"], guard["auth"]["user_id"]); if user_result["ok"] == false { return fail(ctx["cfg"], 404, user_result["code"], user_result["message"], {}) }
		return ok(ctx["cfg"], {"authenticated": true, "user": user_result["user"], "session": {"id": guard["auth"]["session_id"], "provider": guard["auth"]["provider"]}})
	})
	server = server.route("DELETE", "/v1/auth/session", func(req) {
		guard := guard_request(req, ctx, "auth.session"); if guard["ok"] == false { return guard["response"] }
		result := db_execute_safe(ctx["db"], "UPDATE identity_sessions SET revoked_at = ? WHERE id = ? AND revoked_at IS NULL", [now(), guard["auth"]["session_id"]]); if result["ok"] == false { return fail(ctx["cfg"], 500, "session_revoke_failed", "Could not revoke session", {}) }
		_ = write_audit(ctx, req, "identity.session.revoke", 200, "session", guard["auth"]["session_id"], {})
		return ok(ctx["cfg"], {"revoked": true})
	})
	return server
}

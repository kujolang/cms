	server = server.route("GET", "/v1/workspaces", func(req) {
		guard := guard_request(req, ctx, true)
		if guard["ok"] == false {
			return guard["response"]
		}

		cfg := ctx["cfg"]
		query := dict_get_or(req, "query", {})
		list_query := parse_list_query(query, {
			"default_limit": 50,
			"max_limit": 200,
			"default_offset": 0,
			"default_sort_by": "id",
			"default_sort_dir": "asc",
			"allowed_sort_fields": ["id", "workspace_key", "tenant_id", "name", "status", "created_at", "updated_at"]
		})
		limit := list_query["limit"]
		offset := list_query["offset"]
		sort_by := list_query["sort_by"]
		sort_dir := list_query["sort_dir"]
		sort_field := "id"
		if sort_by == "tenant_id" {
			sort_field = "tenant_id"
		} else if sort_by == "workspace_key" {
			sort_field = "workspace_key"
		} else if sort_by == "name" {
			sort_field = "name"
		} else if sort_by == "status" {
			sort_field = "status"
		} else if sort_by == "created_at" {
			sort_field = "created_at"
		} else if sort_by == "updated_at" {
			sort_field = "updated_at"
		} else if sort_by == "disabled_at" {
			sort_field = "disabled_at"
		} else if sort_by == "archived_at" {
			sort_field = "archived_at"
		}
		sort_dir_sql := "ASC"
		if sort_dir == "desc" {
			sort_dir_sql = "DESC"
		}
		auth_context := dict_get_or(guard, "auth", {})
		scope := get_tenant_scope(auth_context)
		sql := "SELECT id, tenant_id, workspace_key, name, status, created_at, updated_at, disabled_at, archived_at FROM workspaces"
		count_sql := "SELECT COUNT(*) AS total FROM workspaces"
		params := []
		count_params := []
		if scope["global"] == false {
			if scope["tenant_id"] <= 0 {
				return fail(cfg, 403, "tenant_scope_denied", "Token has no tenant scope for workspace listing", {})
			}
			sql = sql + " WHERE tenant_id = ?"
			count_sql = count_sql + " WHERE tenant_id = ?"
			params = [scope["tenant_id"]]
			count_params = [scope["tenant_id"]]
		}
		sql = sql + " ORDER BY " + sort_field + " " + sort_dir_sql + " LIMIT ? OFFSET ?"
		params = push(params, limit)
		params = push(params, offset)

		rows := []
		err := null
		try {
			rows = db_query(ctx["db"], sql, params)
		} except e {
			err = e
		}
		if type(err) != "null" {
			return fail(cfg, 500, "db_query_failed", "Failed to load workspaces", {})
		}

		count_rows := []
		count_err := null
		try {
			count_rows = db_query(ctx["db"], count_sql, count_params)
		} except e {
			count_err = e
		}
		if type(count_err) != "null" {
			return fail(cfg, 500, "db_query_failed", "Failed to count workspaces", {})
		}
		total := 0
		if len(count_rows) > 0 {
			total = to_int(count_rows[0]["total"])
		}

		return json_response(200, {
			"ok": true,
			"data": {
				"items": rows,
				"count": len(rows),
				"total": total,
				"limit": limit,
				"offset": offset,
				"sort_by": sort_field,
				"sort_dir": to_lower(sort_dir_sql)
			}
		})
	})

	server = server.route("POST", "/v1/workspaces", func(req) {
		guard := guard_request(req, ctx, true)
		if guard["ok"] == false {
			return guard["response"]
		}

		cfg := ctx["cfg"]
		db := ctx["db"]
		body_text := to_string(dict_get_or(req, "body", ""))
		if trim(body_text) == "" {
			return fail(cfg, 400, "invalid_body", "Request body is required", {})
		}

		body := null
		parse_err := null
		try {
			body = parse_json(body_text)
		} except e {
			parse_err = e
		}
		if type(parse_err) != "null" || type(body) != "dict" {
			return fail(cfg, 400, "invalid_body", "Invalid JSON body", {})
		}

		tenant_id := 0
		tenant_err := null
		try {
			tenant_id = parse_int(trim(to_string(dict_get_or(body, "tenant_id", "0"))))
		} except e {
			tenant_err = e
		}
		if type(tenant_err) != "null" || tenant_id <= 0 {
			return fail(cfg, 400, "invalid_tenant_id", "tenant_id must be a positive integer", {})
		}

		auth_context := dict_get_or(guard, "auth", {})
		tenant_access := ensure_tenant_scoped_access(auth_context, cfg, tenant_id)
		if tenant_access["ok"] == false {
			return tenant_access["response"]
		}

		tenant_rows := []
		check_err := null
		try {
			tenant_rows = db_query(db, "SELECT id, status FROM tenants WHERE id = ? LIMIT 1", [tenant_id])
		} except e {
			check_err = e
		}
		if type(check_err) != "null" {
			return fail(cfg, 500, "db_query_failed", "Failed to validate tenant", {})
		}
		if len(tenant_rows) == 0 {
			return fail(cfg, 404, "tenant_not_found", "Tenant not found", {})
		}
		if tenant_rows[0]["status"] != "active" {
			return fail(cfg, 409, "tenant_inactive", "Cannot create workspace for disabled or archived tenant", {
				"tenant_id": tenant_id,
				"status": tenant_rows[0]["status"]
			})
		}

		workspace_max_count := dict_get_or(cfg, "tenant_workspace_max_count", 250)
		workspace_total_rows := []
		workspace_total_err := null
		try {
			workspace_total_rows = db_query(db, "SELECT COUNT(*) AS total FROM workspaces WHERE tenant_id = ?", [tenant_id])
		} except e {
			workspace_total_err = e
		}
		if type(workspace_total_err) != "null" {
			return fail(cfg, 500, "db_query_failed", "Failed to validate workspace quota", {})
		}
		workspace_total := 0
		if len(workspace_total_rows) > 0 {
			workspace_total = to_int(workspace_total_rows[0]["total"])
		}
		if workspace_total >= workspace_max_count {
			return fail(cfg, 409, "workspace_limit_reached", "Workspace limit reached for tenant", {
				"tenant_id": tenant_id,
				"limit": workspace_max_count,
				"current_count": workspace_total
			})
		}

		workspace_key := trim(to_string(dict_get_or(body, "workspace_key", "")))
		name := trim(to_string(dict_get_or(body, "name", "")))
		status := to_lower(trim(to_string(dict_get_or(body, "status", "active"))))
		if is_valid_slug_key(workspace_key) == false {
			return fail(cfg, 400, "invalid_workspace_key", "workspace_key must be lowercase slug text", {})
		}
		if len(name) < 2 {
			return fail(cfg, 400, "invalid_name", "name must be at least 2 characters", {})
		}
		if status != "active" && status != "disabled" && status != "archived" {
			return fail(cfg, 400, "invalid_status", "status must be active, disabled, or archived", {})
		}

		now_ts := now()
		disabled_at := null
		archived_at := null
		if status == "disabled" {
			disabled_at = now_ts
		}
		if status == "archived" {
			disabled_at = now_ts
			archived_at = now_ts
		}

		insert_err := null
		try {
			db_execute(
				db,
				"INSERT INTO workspaces (tenant_id, workspace_key, name, status, created_at, updated_at, disabled_at, archived_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
				[tenant_id, workspace_key, name, status, now_ts, now_ts, disabled_at, archived_at]
			)
		} except e {
			insert_err = e
		}
		if type(insert_err) != "null" {
			return fail(cfg, 409, "create_failed", "Could not create workspace (duplicate workspace_key for tenant)", {})
		}

		rows := []
		row_err := null
		try {
			rows = db_query(db, "SELECT id, tenant_id, workspace_key, name, status, created_at, updated_at, disabled_at, archived_at FROM workspaces WHERE tenant_id = ? AND workspace_key = ? ORDER BY id DESC LIMIT 1", [tenant_id, workspace_key])
		} except e {
			row_err = e
		}
		if type(row_err) != "null" || len(rows) == 0 {
			return fail(cfg, 500, "load_failed", "Created workspace but failed to load it", {})
		}

		audit_details := {
			"tenant_id": tenant_id,
			"workspace_key": workspace_key,
			"status": status
		}
		audit_err := null
		try {
			_ = write_audit(ctx, req, "workspace.create", 201, "workspace", to_string(rows[0]["id"]), audit_details)
		} except e {
			audit_err = e
		}
		if type(audit_err) != "null" {
			fallback_details := audit_details
			fallback_details["request_id"] = to_string(dict_get_or(req, "request_id", ""))
			auth_context := dict_get_or(req, "auth_context", null)
			if type(auth_context) == "dict" {
				fallback_details["role_key"] = to_string(dict_get_or(auth_context, "role_key", ""))
				fallback_details["token_id"] = to_string(dict_get_or(auth_context, "token_id", ""))
				fallback_details["token_label"] = to_string(dict_get_or(auth_context, "token_label", ""))
			}
			fallback_insert_err := null
			try {
				db_execute(
					db,
					"INSERT INTO audit_log (created_at, ip, method, path, actor, action, status_code, target_type, target_id, details_json) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
					[
						now(),
						req_ip(req),
						to_upper(to_string(dict_get_or(req, "method", "UNKNOWN"))),
						to_string(dict_get_or(req, "path", "")),
						"token",
						"workspace.create",
						201,
						"workspace",
						to_string(rows[0]["id"]),
						to_json(fallback_details)
					]
				)
			} except e {
				fallback_insert_err = e
			}
		}

		response_payload := {"ok": true, "data": rows[0]}
		_ = idempotency_complete(req, ctx, 201, response_payload)
		return json_response(201, response_payload)
	})

	return server
}

export TARGET_SCHEMA_VERSION := 12

func db_query_safe(sql_db, sql_text, sql_params) {
	rows := []
	query_err := null
	try {
		rows = db_query(sql_db, sql_text, sql_params)
	} except e {
		query_err = e
	}
	if type(query_err) != "null" || type(rows) == "error" {
		error_value := query_err
		if type(error_value) == "null" {
			error_value = rows
		}
		return {"ok": false, "error": to_string(error_value), "rows": []}
	}
	return {"ok": true, "rows": rows}
}

func db_execute_safe(sql_db, sql_text, sql_params) {
	result := null
	execute_err := null
	try {
		result = db_execute(sql_db, sql_text, sql_params)
	} except e {
		execute_err = e
	}
	if type(execute_err) != "null" || type(result) == "error" {
		error_value := execute_err
		if type(error_value) == "null" {
			error_value = result
		}
		return {"ok": false, "error": to_string(error_value)}
	}
	return {"ok": true, "result": result}
}

func ensure_schema_version_table(db) {
	create_result := db_execute_safe(
		db,
		"CREATE TABLE IF NOT EXISTS schema_version (id INTEGER PRIMARY KEY CHECK (id = 1), version INTEGER NOT NULL, updated_at TEXT NOT NULL)",
		[]
	)
	if create_result["ok"] == false {
		return create_result
	}

	seed_result := db_execute_safe(
		db,
		"INSERT OR IGNORE INTO schema_version (id, version, updated_at) VALUES (1, 0, ?)",
		[now()]
	)
	if seed_result["ok"] == false {
		return seed_result
	}

	return {"ok": true}
}

export get_schema_version := func(db) {
	table_result := ensure_schema_version_table(db)
	if table_result["ok"] == false {
		return table_result
	}

	version_result := db_query_safe(db, "SELECT version FROM schema_version WHERE id = 1", [])
	if version_result["ok"] == false {
		return version_result
	}

	version := 0
	if len(version_result["rows"]) > 0 {
		version := version_result["rows"][0]["version"]
	}

	return {"ok": true, "version": version}
}

export set_schema_version := func(db, version_value) {
	return db_execute_safe(
		db,
		"UPDATE schema_version SET version = ?, updated_at = ? WHERE id = 1",
		[version_value, now()]
	)
}

export run_post_bootstrap_migrations := func(db) {
	current_result := get_schema_version(db)
	if current_result["ok"] == false {
		return current_result
	}

	current_version := current_result["version"]
	applied := []

	if current_version < 1 {
		# Baseline migration marker for initial schema bootstrap.
		mark_v1 := set_schema_version(db, 1)
		if mark_v1["ok"] == false {
			return mark_v1
		}
		current_version := 1
		applied = push(applied, "v1_baseline")
	}

	if current_version < 2 {
		# Authentication/authorization indexes and metadata for role-token model.
		idx_a := db_execute_safe(db, "CREATE UNIQUE INDEX IF NOT EXISTS idx_api_tokens_hash ON api_tokens(token_hash)", [])
		if idx_a["ok"] == false {
			return idx_a
		}
		idx_b := db_execute_safe(db, "CREATE INDEX IF NOT EXISTS idx_api_tokens_role ON api_tokens(role_key)", [])
		if idx_b["ok"] == false {
			return idx_b
		}
		idx_c := db_execute_safe(db, "CREATE UNIQUE INDEX IF NOT EXISTS idx_roles_role_key ON roles(role_key)", [])
		if idx_c["ok"] == false {
			return idx_c
		}

		mark_v2 := set_schema_version(db, 2)
		if mark_v2["ok"] == false {
			return mark_v2
		}
		current_version := 2
		applied = push(applied, "v2_auth_roles")
	}

	if current_version < 3 {
		rev_table := db_execute_safe(
			db,
			"CREATE TABLE IF NOT EXISTS entry_revisions (id INTEGER PRIMARY KEY AUTOINCREMENT, entry_id INTEGER NOT NULL, title TEXT NOT NULL, slug TEXT NOT NULL, status TEXT NOT NULL, excerpt TEXT NOT NULL, body TEXT NOT NULL, meta_json TEXT NOT NULL, author_id TEXT NOT NULL, published_at TEXT, revision_note TEXT NOT NULL, created_at TEXT NOT NULL, FOREIGN KEY(entry_id) REFERENCES entries(id) ON DELETE CASCADE)",
			[]
		)
		if rev_table["ok"] == false {
			return rev_table
		}

		rev_index := db_execute_safe(
			db,
			"CREATE INDEX IF NOT EXISTS idx_entry_revisions_entry_created ON entry_revisions(entry_id, created_at DESC)",
			[]
		)
		if rev_index["ok"] == false {
			return rev_index
		}

		mark_v3 := set_schema_version(db, 3)
		if mark_v3["ok"] == false {
			return mark_v3
		}
		current_version := 3
		applied = push(applied, "v3_entry_revisions")
	}

	if current_version < 4 {
		columns_result := db_query_safe(db, "PRAGMA table_info(entries)", [])
		if columns_result["ok"] == false {
			return columns_result
		}

		has_unpublish_at := false
		for column_row in columns_result["rows"] {
			column_name := to_string(column_row["name"])
			if column_name == "unpublish_at" {
				has_unpublish_at = true
			}
		}

		if has_unpublish_at == false {
			add_column := db_execute_safe(db, "ALTER TABLE entries ADD COLUMN unpublish_at TEXT", [])
			if add_column["ok"] == false {
				return add_column
			}
		}

		mark_v4 := set_schema_version(db, 4)
		if mark_v4["ok"] == false {
			return mark_v4
		}
		current_version = 4
		applied = push(applied, "v4_entry_unpublish_column")
	}

	if current_version < 5 {
		lock_table := db_execute_safe(
			db,
			"CREATE TABLE IF NOT EXISTS entry_locks (entry_id INTEGER PRIMARY KEY, lock_token TEXT NOT NULL, locked_by TEXT NOT NULL, lock_note TEXT NOT NULL, locked_at TEXT NOT NULL, expires_at TEXT NOT NULL, FOREIGN KEY(entry_id) REFERENCES entries(id) ON DELETE CASCADE)",
			[]
		)
		if lock_table["ok"] == false {
			return lock_table
		}

		lock_index := db_execute_safe(
			db,
			"CREATE INDEX IF NOT EXISTS idx_entry_locks_expires_at ON entry_locks(expires_at)",
			[]
		)
		if lock_index["ok"] == false {
			return lock_index
		}

		mark_v5 := set_schema_version(db, 5)
		if mark_v5["ok"] == false {
			return mark_v5
		}
		current_version = 5
		applied = push(applied, "v5_entry_locks")
	}

	if current_version < 6 {
		jobs_table := db_execute_safe(
			db,
			"CREATE TABLE IF NOT EXISTS background_jobs (id INTEGER PRIMARY KEY AUTOINCREMENT, job_type TEXT NOT NULL, payload_json TEXT NOT NULL, status TEXT NOT NULL, attempt_count INTEGER NOT NULL DEFAULT 0, max_attempts INTEGER NOT NULL DEFAULT 5, run_after TEXT NOT NULL, last_error TEXT, result_json TEXT, started_at TEXT, completed_at TEXT, created_at TEXT NOT NULL, updated_at TEXT NOT NULL)",
			[]
		)
		if jobs_table["ok"] == false {
			return jobs_table
		}

		jobs_idx_a := db_execute_safe(
			db,
			"CREATE INDEX IF NOT EXISTS idx_background_jobs_status_run_after ON background_jobs(status, run_after)",
			[]
		)
		if jobs_idx_a["ok"] == false {
			return jobs_idx_a
		}

		jobs_idx_b := db_execute_safe(
			db,
			"CREATE INDEX IF NOT EXISTS idx_background_jobs_job_type_status ON background_jobs(job_type, status)",
			[]
		)
		if jobs_idx_b["ok"] == false {
			return jobs_idx_b
		}

		jobs_dead_table := db_execute_safe(
			db,
			"CREATE TABLE IF NOT EXISTS background_job_dead_letters (id INTEGER PRIMARY KEY AUTOINCREMENT, job_id INTEGER NOT NULL, job_type TEXT NOT NULL, payload_json TEXT NOT NULL, attempt_count INTEGER NOT NULL, max_attempts INTEGER NOT NULL, last_error TEXT, failed_at TEXT NOT NULL, created_at TEXT NOT NULL, FOREIGN KEY(job_id) REFERENCES background_jobs(id) ON DELETE CASCADE)",
			[]
		)
		if jobs_dead_table["ok"] == false {
			return jobs_dead_table
		}

		jobs_dead_idx := db_execute_safe(
			db,
			"CREATE UNIQUE INDEX IF NOT EXISTS idx_background_job_dead_letters_job_id ON background_job_dead_letters(job_id)",
			[]
		)
		if jobs_dead_idx["ok"] == false {
			return jobs_dead_idx
		}

		mark_v6 := set_schema_version(db, 6)
		if mark_v6["ok"] == false {
			return mark_v6
		}
		current_version = 6
		applied = push(applied, "v6_background_jobs")
	}

	if current_version < 7 {
		begin_result := db_execute_safe(db, "BEGIN IMMEDIATE", [])
		if begin_result["ok"] == false {
			return begin_result
		}

		migration_error := null
		steps := [
			"CREATE TABLE workspaces_v7 (id INTEGER PRIMARY KEY AUTOINCREMENT, tenant_id INTEGER NOT NULL, workspace_key TEXT NOT NULL, name TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL, disabled_at TEXT, archived_at TEXT, FOREIGN KEY(tenant_id) REFERENCES tenants(id) ON DELETE CASCADE, UNIQUE(tenant_id, workspace_key))",
			"INSERT INTO workspaces_v7 (id, tenant_id, workspace_key, name, status, created_at, updated_at, disabled_at, archived_at) SELECT id, tenant_id, workspace_key, name, status, created_at, updated_at, disabled_at, archived_at FROM workspaces",
			"DROP TABLE workspaces",
			"ALTER TABLE workspaces_v7 RENAME TO workspaces",
			"CREATE INDEX idx_workspaces_tenant_id ON workspaces(tenant_id)",
			"CREATE INDEX idx_workspaces_status ON workspaces(status)"
		]
		for step_sql in steps {
			if type(migration_error) == "null" {
				step_result := db_execute_safe(db, step_sql, [])
				if step_result["ok"] == false {
					migration_error = step_result["error"]
				}
			}
		}

		if type(migration_error) != "null" {
			_ = db_execute_safe(db, "ROLLBACK", [])
			return {"ok": false, "error": to_string(migration_error)}
		}

		mark_v7 := set_schema_version(db, 7)
		if mark_v7["ok"] == false {
			_ = db_execute_safe(db, "ROLLBACK", [])
			return mark_v7
		}

		commit_result := db_execute_safe(db, "COMMIT", [])
		if commit_result["ok"] == false {
			_ = db_execute_safe(db, "ROLLBACK", [])
			return commit_result
		}

		current_version = 7
		applied = push(applied, "v7_workspace_keys_per_tenant")
	}

	if current_version < 8 {
		users_table := db_execute_safe(
			db,
			"CREATE TABLE IF NOT EXISTS users (id INTEGER PRIMARY KEY AUTOINCREMENT, user_key TEXT NOT NULL UNIQUE, email TEXT NOT NULL UNIQUE, username TEXT NOT NULL UNIQUE, display_name TEXT NOT NULL, first_name TEXT NOT NULL DEFAULT '', last_name TEXT NOT NULL DEFAULT '', bio TEXT NOT NULL DEFAULT '', website_url TEXT NOT NULL DEFAULT '', avatar_url TEXT NOT NULL DEFAULT '', social_json TEXT NOT NULL DEFAULT '{}', role_key TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'pending', password_hash TEXT NOT NULL, password_salt TEXT NOT NULL, password_iterations INTEGER NOT NULL DEFAULT 210000, email_verified_at TEXT, approved_at TEXT, approved_by TEXT, last_login_at TEXT, created_at TEXT NOT NULL, updated_at TEXT NOT NULL, FOREIGN KEY(role_key) REFERENCES roles(role_key))",
			[]
		)
		if users_table["ok"] == false {
			return users_table
		}

		user_indexes := [
			"CREATE UNIQUE INDEX IF NOT EXISTS idx_users_email_lower ON users(lower(email))",
			"CREATE UNIQUE INDEX IF NOT EXISTS idx_users_username_lower ON users(lower(username))",
			"CREATE INDEX IF NOT EXISTS idx_users_status_role ON users(status, role_key)"
		]
		for user_index_sql in user_indexes {
			user_index := db_execute_safe(db, user_index_sql, [])
			if user_index["ok"] == false {
				return user_index
			}
		}

		mark_v8 := set_schema_version(db, 8)
		if mark_v8["ok"] == false {
			return mark_v8
		}
		current_version = 8
		applied = push(applied, "v8_cms_users")
	}

	if current_version < 9 {
		begin_v9 := db_execute_safe(db, "BEGIN IMMEDIATE", [])
		if begin_v9["ok"] == false {
			return begin_v9
		}

		deactivate_bootstrap := db_execute_safe(
			db,
			"UPDATE api_tokens SET is_active = 0, updated_at = ? WHERE is_active = 1",
			[now()]
		)
		if deactivate_bootstrap["ok"] == false {
			_ = db_execute_safe(db, "ROLLBACK", [])
			return deactivate_bootstrap
		}

		clear_legacy_idempotency := db_execute_safe(db, "DELETE FROM idempotency_keys", [])
		if clear_legacy_idempotency["ok"] == false {
			_ = db_execute_safe(db, "ROLLBACK", [])
			return clear_legacy_idempotency
		}

		mark_v9 := set_schema_version(db, 9)
		if mark_v9["ok"] == false {
			_ = db_execute_safe(db, "ROLLBACK", [])
			return mark_v9
		}
		commit_v9 := db_execute_safe(db, "COMMIT", [])
		if commit_v9["ok"] == false {
			_ = db_execute_safe(db, "ROLLBACK", [])
			return commit_v9
		}
		current_version = 9
		applied = push(applied, "v9_credential_and_idempotency_lifecycle_reset")
	}

	if current_version < 10 {
		columns_result := db_query_safe(db, "PRAGMA table_info(webhook_outbox)", [])
		if columns_result["ok"] == false {
			return columns_result
		}
		has_source_audit_id := false
		for column_row in columns_result["rows"] {
			if to_string(column_row["name"]) == "source_audit_id" {
				has_source_audit_id = true
			}
		}
		if has_source_audit_id == false {
			add_source_audit := db_execute_safe(db, "ALTER TABLE webhook_outbox ADD COLUMN source_audit_id INTEGER", [])
			if add_source_audit["ok"] == false {
				return add_source_audit
			}
		}
		outbox_dedupe_index := db_execute_safe(db, "CREATE UNIQUE INDEX IF NOT EXISTS idx_webhook_outbox_source_hook_event ON webhook_outbox(source_audit_id, hook_id, event_type) WHERE source_audit_id IS NOT NULL", [])
		if outbox_dedupe_index["ok"] == false {
			return outbox_dedupe_index
		}
		mark_v10 := set_schema_version(db, 10)
		if mark_v10["ok"] == false {
			return mark_v10
		}
		current_version = 10
		applied = push(applied, "v10_webhook_outbox_deduplication")
	}

	if current_version < 11 {
		job_columns := db_query_safe(db, "PRAGMA table_info(background_jobs)", [])
		if job_columns["ok"] == false {
			return job_columns
		}
		job_claim_token := false
		job_claim_expires := false
		for column_row in job_columns["rows"] {
			column_name := to_string(column_row["name"])
			if column_name == "claim_token" { job_claim_token = true }
			if column_name == "claim_expires_at" { job_claim_expires = true }
		}
		if job_claim_token == false {
			added := db_execute_safe(db, "ALTER TABLE background_jobs ADD COLUMN claim_token TEXT", [])
			if added["ok"] == false { return added }
		}
		if job_claim_expires == false {
			added := db_execute_safe(db, "ALTER TABLE background_jobs ADD COLUMN claim_expires_at TEXT", [])
			if added["ok"] == false { return added }
		}

		outbox_columns := db_query_safe(db, "PRAGMA table_info(webhook_outbox)", [])
		if outbox_columns["ok"] == false { return outbox_columns }
		outbox_claim_token := false
		outbox_claim_expires := false
		for column_row in outbox_columns["rows"] {
			column_name := to_string(column_row["name"])
			if column_name == "claim_token" { outbox_claim_token = true }
			if column_name == "claim_expires_at" { outbox_claim_expires = true }
		}
		if outbox_claim_token == false {
			added := db_execute_safe(db, "ALTER TABLE webhook_outbox ADD COLUMN claim_token TEXT", [])
			if added["ok"] == false { return added }
		}
		if outbox_claim_expires == false {
			added := db_execute_safe(db, "ALTER TABLE webhook_outbox ADD COLUMN claim_expires_at TEXT", [])
			if added["ok"] == false { return added }
		}

		mark_v11 := set_schema_version(db, 11)
		if mark_v11["ok"] == false { return mark_v11 }
		current_version = 11
		applied = push(applied, "v11_worker_claim_leases")
	}

	if current_version < 12 {
		steps_v12 := [
			"CREATE TABLE IF NOT EXISTS identity_links (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, provider TEXT NOT NULL, provider_subject TEXT NOT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL, FOREIGN KEY(user_id) REFERENCES users(id) ON DELETE CASCADE, UNIQUE(provider, provider_subject))",
			"CREATE INDEX IF NOT EXISTS idx_identity_links_user ON identity_links(user_id)",
			"CREATE TABLE IF NOT EXISTS identity_sessions (id INTEGER PRIMARY KEY AUTOINCREMENT, token_hash TEXT NOT NULL UNIQUE, user_id INTEGER NOT NULL, provider TEXT NOT NULL, provider_subject TEXT NOT NULL, expires_at INTEGER NOT NULL, last_seen_at TEXT, revoked_at TEXT, created_at TEXT NOT NULL, FOREIGN KEY(user_id) REFERENCES users(id) ON DELETE CASCADE)",
			"CREATE INDEX IF NOT EXISTS idx_identity_sessions_user ON identity_sessions(user_id)",
			"CREATE INDEX IF NOT EXISTS idx_identity_sessions_expiry ON identity_sessions(expires_at)"
		]
		for step_v12 in steps_v12 {
			result_v12 := db_execute_safe(db, step_v12, [])
			if result_v12["ok"] == false { return result_v12 }
		}
		mark_v12 := set_schema_version(db, 12)
		if mark_v12["ok"] == false { return mark_v12 }
		current_version = 12
		applied = push(applied, "v12_identity_sessions")
	}

	return {
		"ok": true,
		"version": current_version,
		"target_version": TARGET_SCHEMA_VERSION,
		"applied": applied
	}
}

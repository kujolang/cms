CMS_API_HOST=127.0.0.1
CMS_API_PORT=4200
CMS_SITE_URL=http://127.0.0.1:4200
CMS_DB_PATH=cms.db
CMS_CORS_ORIGIN=*
CMS_API_TOKEN=
CMS_ENV=development
CMS_ALLOW_BOOTSTRAP_TOKEN=false
CMS_ENFORCE_BOOTSTRAP_TOKEN_ROTATION=true
CMS_MAX_BODY_BYTES=1048576
CMS_RATE_WINDOW_SEC=60
CMS_RATE_MAX_REQUESTS=180
CMS_RATE_LIMIT_MODE=memory
CMS_RATE_MAX_KEYS=10000
CMS_TENANT_MAX_COUNT=5000
CMS_TENANT_WORKSPACE_MAX_COUNT=250
CMS_AUDIT_LOG=true
CMS_STRUCTURED_LOGS=true
CMS_READINESS_CHECK_DB=true
CMS_METRICS_ENABLED=true
CMS_IDEMPOTENCY_ENABLED=true
CMS_REQUEST_ID_HEADER=X-Request-ID
CMS_PLUGIN_HOOK_URL_ALLOWLIST=
CMS_PLUGIN_HOOK_URL_DENYLIST=localhost,127.*,10.*,172.*,192.168.*,169.254.*,0.0.0.0,::1,*.local
CMS_PLUGIN_HOOK_ALLOW_HTTP=false
CMS_WEBHOOK_MAX_ATTEMPTS=5
CMS_WEBHOOK_RETRY_BASE_SEC=30
CMS_WEBHOOK_CONNECT_TIMEOUT_SEC=3
CMS_WEBHOOK_MAX_TIME_SEC=10
CMS_BACKGROUND_JOB_MAX_ATTEMPTS=5
CMS_BACKGROUND_JOB_RETRY_BASE_SEC=20
CMS_BACKGROUND_JOB_PROCESS_LIMIT=50
CMS_SECURITY_CONTACT=mailto:security@example.com
CMS_SECURITY_POLICY_URL=
CMS_SECURITY_ACKNOWLEDGMENTS_URL=
CMS_SECURITY_PREFERRED_LANGUAGES=en
CMS_SECURITY_EXPIRES=2027-12-31T23:59:59Z

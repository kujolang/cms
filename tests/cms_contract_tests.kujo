test_setup {
	from backend.core.utils import is_valid_slug_key, parse_list_query, parse_nonnegative_int_text, parse_positive_int_text
	from backend.core.http import get_header, parse_bounded_int, req_actor
	from backend.config.config import load_config, load_config_impl
	from backend.modules.auth import authorize_request, permissions_allow
	from backend.core.database import connect_database, db_execute_safe, db_query_safe
	from backend.core.migrations import get_schema_version, TARGET_SCHEMA_VERSION
	from backend.routes.delivery import build_llms_txt, build_robots_txt, build_rss_xml, build_security_txt, build_sitemap_xml
	from backend.routes.entries import build_seo_audit_item, can_read_entry_status
	from backend.routes.media import parse_media_size_bytes
	from backend.routes.plugins import list_webhook_event_schemas, validate_webhook_event_payload, webhook_schema_for
	from backend.routes.abilities import ability_categories, ability_registry, connector_registry, find_ability, mcp_tool_descriptors, resolved_ability_registry, resolved_connector_registry
	from backend.routes.webmcp import build_webmcp_manifest, build_webmcp_runtime_source, public_content_record, webmcp_entry_allowed, webmcp_tool_registry
	from backend.routes.extensions import extension_contracts, validate_package_receipt, validate_plugin_manifest, validate_theme_manifest
}

test "extension package receipts are bounded and tied to their manifest type" {
	receipt := {"format": "zip", "filename": "field-notes-1.0.2.zip", "size_bytes": 240000, "uncompressed_bytes": 920000, "file_count": 74, "manifest_path": "field-notes/kujo-theme.json", "sha256": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"}
	assert_equal(validate_package_receipt(receipt, "theme")["ok"], true)
	receipt["manifest_path"] = "field-notes/kujo-plugin.json"
	assert_equal(validate_package_receipt(receipt, "theme")["code"], "invalid_package_manifest_path")
	receipt["manifest_path"] = "../kujo-theme.json"
	assert_equal(validate_package_receipt(receipt, "theme")["code"], "invalid_package_manifest_path")
	receipt["manifest_path"] = "field-notes/kujo-theme.json"
	receipt["uncompressed_bytes"] = 70000000
	assert_equal(validate_package_receipt(receipt, "theme")["code"], "invalid_package_limits")
}

test "portable theme manifests are strict, distributable, and secret-free" {
	manifest := {"schema": "kujo.theme/v1", "key": "field_notes", "name": "Field Notes", "version": "1.2.0", "description": "Portable frontend", "license": "MIT", "author": {"name": "Kujo", "url": "https://kujo.dev"}, "compatibility": {"cms": ">=1.0.0"}, "entrypoints": {"web": "app/layout.tsx"}, "templates": {"single": "app/articles/page.tsx"}, "assets": {"styles": ["app/globals.css"], "scripts": [], "images": []}, "settings_schema": {"type": "object", "additionalProperties": false}, "defaults": {}, "supports": ["menus", "webmcp"], "content_types": ["article"], "menu_locations": ["header"], "distribution": {"homepage": "https://kujo.dev", "repository": "https://github.com/kujolang/cms", "package_url": "", "integrity": ""}, "admin": {"icon": "/images/field-notes.webp", "navigation": [{"key": "theme_docs", "label": "Theme docs", "href": "/cms/themes", "order": 650, "capability": "manage_extensions", "icon": ""}]}}
	result := validate_theme_manifest(manifest)
	assert_equal(result["ok"], true)
	assert_equal(result["manifest"]["key"], "field_notes")
	assert_equal(result["manifest"]["name"], "Field Notes")
	assert_equal(result["manifest"]["admin"]["navigation"][0]["order"], 650)
	assert_equal(has_key(result["manifest"], "secrets") == 1, false)
	manifest["unexpected"] = true
	assert_equal(validate_theme_manifest(manifest)["code"], "unknown_manifest_fields")
	manifest = result["manifest"]
	manifest["entrypoints"] = {"web": "../private/config"}
	assert_equal(validate_theme_manifest(manifest)["code"], "invalid_entrypoint")
	manifest = result["manifest"]
	manifest["admin"] = {"icon": "/images/field-notes.webp", "navigation": [{"key": "theme_docs", "label": "Theme docs", "href": "https://outside.example.test", "order": 650, "capability": "manage_extensions", "icon": ""}]}
	assert_equal(validate_theme_manifest(manifest)["code"], "invalid_admin_navigation_href")
}

test "portable plugin manifests declare bounded external runtimes" {
	manifest := {"schema": "kujo.plugin/v1", "key": "content_notifier", "name": "Content Notifier", "version": "1.0.0", "description": "Notification connector", "license": "MIT", "author": {"name": "Kujo", "url": "https://kujo.dev"}, "compatibility": {"cms": ">=1.0.0"}, "runtime": "webhook", "capabilities": ["events.receive"], "events": ["entry.published"], "abilities": [], "settings_schema": {"type": "object"}, "defaults": {}, "distribution": {"homepage": "", "repository": "", "package_url": "", "integrity": ""}}
	result := validate_plugin_manifest(manifest)
	assert_equal(result["ok"], true)
	assert_equal(result["manifest"]["runtime"], "webhook")
	assert_equal(result["manifest"]["name"], "Content Notifier")
	manifest["runtime"] = "embedded_server_code"
	assert_equal(validate_plugin_manifest(manifest)["code"], "invalid_runtime")
	manifest["runtime"] = "connector"
	manifest["defaults"] = {"api_key": "must-not-live-in-manifest"}
	assert_equal(validate_plugin_manifest(manifest)["code"], "invalid_settings")
	contracts := extension_contracts()
	assert_equal(contracts["security"]["remote_code_downloaded"], false)
	assert_equal(contracts["security"]["secrets_exported"], false)
}

test "WebMCP ships enabled with four bounded read-only browser tools" {
	tools := webmcp_tool_registry()
	assert_equal(len(tools), 4)
	assert_equal(tools[0]["name"], "get_site_info")
	assert_equal(tools[3]["name"], "get_content")
	for tool in tools {
		assert_equal(tool["annotations"]["readOnlyHint"], true)
		assert_equal(tool["annotations"]["untrustedContentHint"], true)
		assert_equal(tool["inputSchema"]["additionalProperties"], false)
	}
	manifest := build_webmcp_manifest({"site_url": "https://example.test/", "webmcp_enabled": true})
	assert_equal(manifest["enabled"], true)
	assert_equal(manifest["automatic"], true)
	assert_equal(manifest["runtime"], "https://example.test/assets/js/kujo-webmcp.js")
	assert_true(to_bool(contains(manifest["script_tag"], "data-kujo-webmcp") >= 0))
	runtime := build_webmcp_runtime_source()
	assert_true(to_bool(contains(runtime, "document.modelContext") >= 0))
	assert_true(to_bool(contains(runtime, "registerTool") >= 0))
}

test "WebMCP exposes only bounded published content and honors exclusions" {
	published := {"id": 7, "content_type_key": "article", "title": "<b>Useful</b>", "slug": "useful", "status": "published", "excerpt": "A public excerpt", "body": "<p>Public body</p> with `formatting`", "meta_json": to_json({"lang": "en", "secret": "never-return"}), "published_at": 1, "updated_at": 2}
	assert_equal(webmcp_entry_allowed(published, false), true)
	assert_equal(webmcp_entry_allowed({"status": "draft"}, false), false)
	assert_equal(webmcp_entry_allowed({"status": "published", "meta_json": to_json({"webmcp_exclude": true})}, false), false)
	assert_equal(webmcp_entry_allowed({"status": "published", "meta_json": to_json({"search_exclude": true})}, true), false)
	record := public_content_record(published, {"category": ["Guides"]}, "https://example.test", 20)
	assert_equal(record["title"], "Useful")
	assert_true(to_bool(len(record["summary"]) <= 20))
	assert_equal(has_key(record, "meta") == 1, false)
	assert_equal(has_key(record, "body") == 1, false)
	assert_equal(contains(to_json(record), "never-return"), 0)
}

test "abilities are discoverable, namespaced, schema-described, and MCP-ready" {
	abilities := ability_registry()
	assert_true(to_bool(len(abilities) >= 6))
	assert_true(to_bool(len(ability_categories()) >= 4))
	seo_update := find_ability("seo", "update-entry")
	assert_equal(type(seo_update), "dict")
	assert_equal(seo_update["annotations"]["requires_confirmation"], true)
	assert_equal(seo_update["permission"], "cms.write")
	assert_equal(type(find_ability("missing", "ability")), "null")
	tools := mcp_tool_descriptors()
	assert_equal(len(tools), len(abilities))
	assert_equal(tools[0]["execution"], "/v1/abilities/cms/site-info/run")
}

test "connector registry reports configuration without returning endpoint values" {
	connectors := connector_registry({"ai_sdk_endpoint": "https://gateway.example.test", "mcp_endpoint": ""})
	assert_true(to_bool(len(connectors) >= 12))
	assert_equal(connectors[0]["configured"], true)
	assert_equal(connectors[2]["configured"], false)
	assert_equal(has_key(connectors[0], "endpoint") == 1, false)
	assert_equal(connectors[0]["secret_storage"], "external")
}

test "slug validation enforces lowercase-safe keys" {
	assert_equal(is_valid_slug_key("article"), true)
	assert_equal(is_valid_slug_key("content_type_01"), true)
	assert_equal(is_valid_slug_key("Article"), false)
	assert_equal(is_valid_slug_key("bad slug"), false)
}

test "slug fallback normalization can produce invalid short slug" {
	fallback_slug := to_lower("!!!")
	fallback_slug = regex_replace(fallback_slug, "[^a-z0-9_\\-]", "-")
	fallback_slug = regex_replace(fallback_slug, "-{2,}", "-")
	fallback_slug = trim(fallback_slug)
	assert_true(to_bool(len(fallback_slug) < 2))
}

test "SEO audit helper exposes granular readiness evidence" {
	item := build_seo_audit_item({
		"id": 7,
		"content_type_key": "article",
		"title": "A useful article",
		"slug": "useful-article",
		"status": "published",
		"excerpt": "A useful excerpt",
		"body": "one two three four",
		"author_id": "editor",
		"meta_json": to_json({"seo": {"title": "A deliberately clear search title for the article", "description": "A sufficiently descriptive search snippet that gives readers a concrete reason to visit and understand what the article contains.", "focus_keyword": "useful article", "og_image_url": "https://example.test/card.webp"}}),
		"updated_at": 1,
		"published_at": 1
	}, "https://example.test", 2)
	assert_equal(item["readiness"], "ready")
	assert_equal(item["seo"]["focus_keyword"], "useful article")
	assert_equal(item["term_count"], 2)
	assert_equal(item["url"], "https://example.test/article/useful-article")

	missing := build_seo_audit_item({"id": 8, "content_type_key": "page", "title": "Thin", "slug": "thin", "body": "", "meta_json": "{}"}, "https://example.test/", 0)
	assert_equal(missing["readiness"], "needs_work")
	assert_true(to_bool(contains(to_json(missing["issues"]), "missing_keyword") >= 0))
	assert_true(to_bool(missing["score"] < 100))
}

test "parse positive integer helper honors defaults" {
	assert_equal(parse_positive_int_text("42", -1), 42)
	assert_equal(parse_positive_int_text("0", 9), 9)
	assert_equal(parse_positive_int_text("invalid", 9), 9)
	assert_equal(parse_nonnegative_int_text("0", 9), 0)
	assert_equal(parse_nonnegative_int_text("-1", 9), 9)
}

test "media size parser rejects negative and malformed values" {
	assert_equal(parse_media_size_bytes(0)["ok"], true)
	assert_equal(parse_media_size_bytes("42")["value"], 42)
	assert_equal(parse_media_size_bytes(-1)["ok"], false)
	assert_equal(parse_media_size_bytes("not-a-size")["ok"], false)
}

test "list query parser bounds malformed pagination and sort input" {
	parsed := parse_list_query({
		"limit": "not-a-number",
		"offset": "-12",
		"sort_by": "unsafe_sql_fragment",
		"sort_dir": "sideways"
	}, {
		"default_limit": 25,
		"max_limit": 100,
		"default_offset": 3,
		"default_sort_by": "id",
		"default_sort_dir": "desc",
		"allowed_sort_fields": ["id", "created_at"]
	})

	assert_equal(parsed["limit"], 25)
	assert_equal(parsed["offset"], 3)
	assert_equal(parsed["sort_by"], "id")
	assert_equal(parsed["sort_dir"], "desc")

	clamped := parse_list_query({
		"limit": "999",
		"offset": "0",
		"sort_by": "created_at",
		"sort_dir": "asc"
	}, {
		"default_limit": 25,
		"max_limit": 100,
		"default_offset": 3,
		"default_sort_by": "id",
		"default_sort_dir": "desc",
		"allowed_sort_fields": ["id", "created_at"]
	})

	assert_equal(clamped["limit"], 100)
	assert_equal(clamped["offset"], 0)
	assert_equal(clamped["sort_by"], "created_at")
	assert_equal(clamped["sort_dir"], "asc")
}

test "config applies enterprise bootstrap defaults in production" {
	development_placeholder_cfg := load_config({
		"environment": "development",
		"api_token": "change-me-in-production",
		"allow_bootstrap_token": true,
		"enforce_bootstrap_token_rotation": false
	})
	assert_equal(development_placeholder_cfg["allow_bootstrap_token"], false)
	assert_equal(development_placeholder_cfg["enforce_bootstrap_token_rotation"], true)

	production_cfg := load_config({
		"environment": "production"
	})
	assert_equal(production_cfg["allow_bootstrap_token"], false)
	assert_equal(production_cfg["enforce_bootstrap_token_rotation"], true)
	assert_equal(production_cfg["rate_limit_mode"], "memory")
	assert_equal(production_cfg["entry_lock_ttl_sec"], 900)

	override_cfg := load_config({
		"environment": "production",
		"api_host": "127.0.0.1",
		"api_token": "ProdTokenContract#123456",
		"allow_bootstrap_token": true,
		"enforce_bootstrap_token_rotation": false,
		"rate_limit_mode": "external",
		"entry_lock_ttl_sec": 60
	})
	assert_equal(override_cfg["allow_bootstrap_token"], true)
	assert_equal(override_cfg["enforce_bootstrap_token_rotation"], false)
	assert_equal(override_cfg["rate_limit_mode"], "external")
	assert_equal(override_cfg["entry_lock_ttl_sec"], 60)

	invalid_mode_cfg := load_config({
		"rate_limit_mode": "unsupported"
	})
	assert_equal(invalid_mode_cfg["rate_limit_mode"], "memory")
}

test "config wrapper delegates to backend implementation without shape drift" {
	overrides := {
		"environment": "production",
		"port": 4310,
		"site_url": "https://cms.example.com",
		"allow_bootstrap_token": true,
		"enforce_bootstrap_token_rotation": false,
		"rate_limit_mode": "external",
		"entry_lock_ttl_sec": 60
	}

	wrapped_cfg := load_config(overrides)
	impl_cfg := load_config_impl(overrides)

	keys := [
		"service_name",
		"service_version",
		"environment",
		"api_host",
		"port",
		"site_url",
		"db_path",
		"cors_origin",
		"api_token",
		"allow_bootstrap_token",
		"enforce_bootstrap_token_rotation",
		"max_body_bytes",
		"rate_limit_window_sec",
		"rate_limit_max_requests",
		"entry_lock_ttl_sec",
		"rate_limit_mode",
		"rate_limit_max_keys",
		"audit_log",
		"security_contact",
		"security_policy_url",
		"security_acknowledgments_url",
		"security_preferred_languages",
		"security_expires"
	]

	for key in keys {
		assert_equal(has_key(wrapped_cfg, key) == 1, true)
		assert_equal(has_key(impl_cfg, key) == 1, true)
		assert_equal(wrapped_cfg[key], impl_cfg[key])
	}
}

test "config defaults api host to localhost and honors override" {
	default_cfg := load_config({})
	assert_equal(default_cfg["api_host"], "127.0.0.1")
	assert_equal(default_cfg["webmcp_enabled"], true)

	override_cfg := load_config({
		"api_host": "0.0.0.0",
		"webmcp_enabled": false,
		"webmcp_max_scan_records": 999999,
		"webmcp_index_page_size_max": 1,
		"webmcp_summary_max_chars": 9999
	})
	assert_equal(override_cfg["api_host"], "0.0.0.0")
	assert_equal(override_cfg["webmcp_enabled"], false)
	assert_equal(override_cfg["webmcp_max_scan_records"], 50000)
	assert_equal(override_cfg["webmcp_index_page_size_max"], 10)
	assert_equal(override_cfg["webmcp_summary_max_chars"], 2000)
}

test "bounded int parser supports zero offset" {
	offset_ok := parse_bounded_int("0", "offset", 0, 100)
	assert_equal(offset_ok["ok"], true)
	assert_equal(offset_ok["value"], 0)

	offset_low := parse_bounded_int("-1", "offset", 0, 100)
	assert_equal(offset_low["ok"], false)
}

test "permission matcher supports exact and wildcard scopes" {
	assert_equal(permissions_allow(["cms.read"], "cms.read"), true)
	assert_equal(permissions_allow(["entries.*"], "entries.write"), true)
	assert_equal(permissions_allow(["*"], "themes.activate"), true)
	assert_equal(permissions_allow(["cms.read"], "cms.write"), false)
}

test "typed webhook schemas are published for supported events" {
	schemas := list_webhook_event_schemas()
	assert_true(to_bool(len(schemas) >= 7))

	published_schema := webhook_schema_for("entry.published")
	assert_equal(type(published_schema), "dict")
	assert_equal(published_schema["event_type"], "entry.published")
	assert_true(to_bool(contains(to_json(published_schema["required_data"]), "published_at") >= 0))

	unknown_schema := webhook_schema_for("entry.unknown")
	assert_equal(type(unknown_schema), "null")
}

test "webhook payload validator enforces required schema fields" {
	valid_payload := {
		"event_id": "evt_123",
		"event_type": "entry.created",
		"occurred_at": "2026-05-20T00:00:00Z",
		"resource": "entry",
		"action": "created",
		"data": {
			"entry_id": 42,
			"content_type_key": "news",
			"slug": "hello-world",
			"status": "published"
		}
	}

	valid_result := validate_webhook_event_payload("entry.created", valid_payload)
	assert_equal(valid_result["ok"], true)

	invalid_payload := {
		"event_id": "evt_456",
		"event_type": "entry.created",
		"occurred_at": "2026-05-20T00:00:00Z",
		"resource": "entry",
		"action": "created",
		"data": {
			"entry_id": 7,
			"content_type_key": "news"
		}
	}

	invalid_result := validate_webhook_event_payload("entry.created", invalid_payload)
	assert_equal(invalid_result["ok"], false)
	assert_true(to_bool(contains(to_json(invalid_result["details"]["missing_data_fields"]), "slug") >= 0))
}

test "delivery helpers generate machine-readable documents" {
	cfg := load_config({
		"service_name": "Test CMS",
		"service_version": "1.0.0",
		"site_url": "https://cms.example.com/"
	})

	rows := [
		{
			"id": 10,
			"content_type_key": "article",
			"slug": "hello-world",
			"title": "Hello World",
			"excerpt": "Seed excerpt",
			"published_at": "2026-05-18T00:00:00Z",
			"updated_at": "2026-05-18T01:00:00Z"
		}
	]

	robots := build_robots_txt(cfg)
	assert_true(to_bool(contains(robots, "Sitemap: https://cms.example.com/sitemap.xml") >= 0))

	sitemap := build_sitemap_xml(cfg, rows)
	assert_true(to_bool(contains(sitemap, "<loc>https://cms.example.com/article/hello-world</loc>") >= 0))

	rss := build_rss_xml(cfg, rows)
	assert_true(to_bool(contains(rss, "<title>Hello World</title>") >= 0))
	assert_true(to_bool(contains(rss, "<link>https://cms.example.com/article/hello-world</link>") >= 0))

	llms := build_llms_txt(cfg)
	assert_true(to_bool(contains(llms, "https://cms.example.com/v1") >= 0))
	assert_true(to_bool(contains(llms, "Entry by slug") >= 0))

	security := build_security_txt(cfg)
	assert_true(to_bool(contains(security, "Contact: mailto:security@example.com") >= 0))
	assert_true(to_bool(contains(security, "Canonical: https://cms.example.com/.well-known/security.txt") >= 0))
}

test "database bootstrap applies schema version and auth seeds" {
	if path_exists("results") == false {
		create_dir("results")
	}

	db_path := "./results/test_cms_contract.db"
	if file_exists(db_path) { delete_file(db_path) }
	if file_exists(db_path + "-wal") { delete_file(db_path + "-wal") }
	if file_exists(db_path + "-shm") { delete_file(db_path + "-shm") }
	cfg := load_config({
		"db_path": db_path,
		"api_token": "contract-token-123456789",
		"audit_log": false
	})

	connection := connect_database(cfg)
	assert_equal(connection["ok"], true)

	db := connection["db"]
	roles_result := db_query_safe(db, "SELECT COUNT(*) AS total FROM roles", [])
	assert_equal(roles_result["ok"], true)
	assert_true(to_bool(roles_result["rows"][0]["total"] >= 5))

	user_table_result := db_query_safe(db, "SELECT COUNT(*) AS total FROM users", [])
	assert_equal(user_table_result["ok"], true)

	registration_result := db_query_safe(db, "SELECT setting_value FROM settings WHERE setting_key = 'user_registration' LIMIT 1", [])
	assert_equal(registration_result["ok"], true)
	assert_equal(len(registration_result["rows"]), 1)
	assert_true(to_bool(contains(to_string(registration_result["rows"][0]["setting_value"]), "approval") >= 0))
	social_result := db_query_safe(db, "SELECT setting_value FROM settings WHERE setting_key = 'social_sharing' LIMIT 1", [])
	assert_equal(social_result["ok"], true)
	assert_equal(len(social_result["rows"]), 1)
	assert_true(to_bool(contains(to_string(social_result["rows"][0]["setting_value"]), "linkedin") >= 0))
	assert_true(to_bool(contains(to_string(social_result["rows"][0]["setting_value"]), "pinterest") >= 0))
	assert_true(to_bool(contains(to_string(social_result["rows"][0]["setting_value"]), "whatsapp") >= 0))

	tokens_result := db_query_safe(db, "SELECT COUNT(*) AS total FROM api_tokens", [])
	assert_equal(tokens_result["ok"], true)
	assert_equal(tokens_result["rows"][0]["total"], 0)

	version_result := get_schema_version(db)
	assert_equal(version_result["ok"], true)
	assert_true(to_bool(version_result["version"] >= TARGET_SCHEMA_VERSION))

	plugin_manifest := {"schema": "kujo.plugin/v1", "key": "test_agent_plugin", "name": "Test Agent Plugin", "abilities": [{"name": "test.records.list", "label": "List test records", "description": "List records", "method": "GET", "path": "/v1/records", "permission": "cms.read"}], "connectors": [{"key": "records", "label": "Records", "purpose": "Test connector", "mode": "plugin_runtime"}], "admin": {"icon": "", "navigation": []}}
	plugin_insert := db_execute_safe(db, "INSERT INTO plugins (plugin_key, name, version, status, capabilities_json, config_json, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)", ["test_agent_plugin", "Test Agent Plugin", "1.0.0", "active", "[]", to_json({"package_manifest": plugin_manifest}), now(), now()])
	assert_equal(plugin_insert["ok"], true)
	resolved_abilities := resolved_ability_registry({"db": db, "cfg": cfg})
	assert_true(to_bool(len(resolved_abilities) > len(ability_registry())))
	assert_equal(resolved_abilities[len(resolved_abilities) - 1]["name"], "test/records-list")
	resolved_connectors := resolved_connector_registry({"db": db, "cfg": cfg})
	assert_equal(resolved_connectors[len(resolved_connectors) - 1]["key"], "test_agent_plugin-records")
	assert_equal(resolved_connectors[len(resolved_connectors) - 1]["manageable"], false)

	if file_exists(db_path) {
		delete_file(db_path)
	}
	if file_exists(db_path + "-wal") {
		delete_file(db_path + "-wal")
	}
	if file_exists(db_path + "-shm") {
		delete_file(db_path + "-shm")
	}
}

test "workspace keys are unique within a tenant instead of globally" {
	if path_exists("results") == false {
		create_dir("results")
	}

	db_path := "./results/test_workspace_scope.db"
	if file_exists(db_path) {
		delete_file(db_path)
	}
	if file_exists(db_path + "-wal") {
		delete_file(db_path + "-wal")
	}
	if file_exists(db_path + "-shm") {
		delete_file(db_path + "-shm")
	}
	pre_migration_db := db_connect("sqlite", db_path)
	now_ts := now()
	_ = db_execute(pre_migration_db, "CREATE TABLE tenants (id INTEGER PRIMARY KEY AUTOINCREMENT, tenant_key TEXT NOT NULL UNIQUE, name TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL, disabled_at TEXT, archived_at TEXT)", [])
	_ = db_execute(pre_migration_db, "CREATE TABLE workspaces (id INTEGER PRIMARY KEY AUTOINCREMENT, tenant_id INTEGER NOT NULL, workspace_key TEXT NOT NULL UNIQUE, name TEXT NOT NULL, status TEXT NOT NULL, created_at TEXT NOT NULL, updated_at TEXT NOT NULL, disabled_at TEXT, archived_at TEXT, FOREIGN KEY(tenant_id) REFERENCES tenants(id) ON DELETE CASCADE)", [])
	_ = db_execute(pre_migration_db, "CREATE TABLE schema_version (id INTEGER PRIMARY KEY CHECK (id = 1), version INTEGER NOT NULL, updated_at TEXT NOT NULL)", [])
	_ = db_execute(pre_migration_db, "INSERT INTO schema_version (id, version, updated_at) VALUES (1, 6, ?)", [now_ts])
	_ = db_execute(pre_migration_db, "INSERT INTO tenants (tenant_key, name, status, created_at, updated_at) VALUES (?, ?, ?, ?, ?)", ["tenant-one", "Tenant One", "active", now_ts, now_ts])
	_ = db_execute(pre_migration_db, "INSERT INTO tenants (tenant_key, name, status, created_at, updated_at) VALUES (?, ?, ?, ?, ?)", ["tenant-two", "Tenant Two", "active", now_ts, now_ts])
	_ = db_execute(pre_migration_db, "INSERT INTO workspaces (tenant_id, workspace_key, name, status, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?)", [1, "primary", "Primary One", "active", now_ts, now_ts])

	connection := connect_database(load_config({
		"db_path": db_path,
		"api_token": "workspace-scope-contract-token",
		"audit_log": false
	}))
	assert_equal(connection["ok"], true)
	assert_equal(connection["schema_version"], TARGET_SCHEMA_VERSION)
	db := connection["db"]

	tenant_rows := db_query_safe(db, "SELECT id, tenant_key FROM tenants WHERE tenant_key IN (?, ?) ORDER BY tenant_key ASC", ["tenant-one", "tenant-two"])
	assert_equal(tenant_rows["ok"], true)
	assert_equal(len(tenant_rows["rows"]), 2)
	tenant_one_id := tenant_rows["rows"][0]["id"]
	tenant_two_id := tenant_rows["rows"][1]["id"]

	insert_two := db_execute_safe(db, "INSERT INTO workspaces (tenant_id, workspace_key, name, status, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?)", [tenant_two_id, "primary", "Primary Two", "active", now_ts, now_ts])
	duplicate_one := db_execute_safe(db, "INSERT INTO workspaces (tenant_id, workspace_key, name, status, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?)", [tenant_one_id, "primary", "Duplicate", "active", now_ts, now_ts])
	assert_equal(insert_two["ok"], true)
	assert_equal(duplicate_one["ok"], false)

	if file_exists(db_path) {
		delete_file(db_path)
	}
	if file_exists(db_path + "-wal") {
		delete_file(db_path + "-wal")
	}
	if file_exists(db_path + "-shm") {
		delete_file(db_path + "-shm")
	}
}

test "schema v8 webhook outbox upgrades before new-column indexes are created" {
	if path_exists("results") == false { create_dir("results") }
	db_path := "./results/test_webhook_v8_upgrade.db"
	if file_exists(db_path) { delete_file(db_path) }
	pre_migration_db := db_connect("sqlite", db_path)
	_ = db_execute(pre_migration_db, "CREATE TABLE webhook_outbox (id INTEGER PRIMARY KEY AUTOINCREMENT, hook_id INTEGER NOT NULL, event_id TEXT NOT NULL, event_type TEXT NOT NULL, payload_json TEXT NOT NULL, handler_url TEXT NOT NULL, shared_secret TEXT NOT NULL, status TEXT NOT NULL, attempt_count INTEGER NOT NULL DEFAULT 0, max_attempts INTEGER NOT NULL DEFAULT 5, next_attempt_at TEXT NOT NULL, last_error TEXT, last_status_code INTEGER, delivered_at TEXT, created_at TEXT NOT NULL, updated_at TEXT NOT NULL)", [])
	_ = db_execute(pre_migration_db, "CREATE TABLE schema_version (id INTEGER PRIMARY KEY CHECK (id = 1), version INTEGER NOT NULL, updated_at TEXT NOT NULL)", [])
	_ = db_execute(pre_migration_db, "INSERT INTO schema_version (id, version, updated_at) VALUES (1, 8, ?)", [now()])
	connection := connect_database(load_config({"db_path": db_path, "api_token": "webhook-upgrade-contract-token", "audit_log": false}))
	assert_equal(connection["ok"], true)
	assert_equal(connection["schema_version"], TARGET_SCHEMA_VERSION)
	db := connection["db"]
	columns := db_query_safe(db, "PRAGMA table_info(webhook_outbox)", [])
	assert_true(to_bool(contains(to_json(columns["rows"]), "source_audit_id") >= 0))
	indexes := db_query_safe(db, "PRAGMA index_list(webhook_outbox)", [])
	assert_true(to_bool(contains(to_json(indexes["rows"]), "idx_webhook_outbox_source_hook_event") >= 0))
	if file_exists(db_path) { delete_file(db_path) }
	if file_exists(db_path + "-wal") { delete_file(db_path + "-wal") }
	if file_exists(db_path + "-shm") { delete_file(db_path + "-shm") }
}

test "auth contract keeps read-open and write-guarded behavior" {
	if path_exists("results") == false {
		create_dir("results")
	}

	db_path := "./results/test_auth_contract.db"
	cfg := load_config({
		"db_path": db_path,
		"api_token": "contract-bootstrap-token-1234567890",
		"allow_bootstrap_token": true,
		"audit_log": false
	})

	connection := connect_database(cfg)
	assert_equal(connection["ok"], true)

	ctx := {
		"cfg": cfg,
		"db": connection["db"],
		"state": {
			"rate": {},
			"entry_locks": {}
		}
	}

	read_auth := authorize_request({
		"method": "GET",
		"headers": {}
	}, ctx, get_header, false)
	assert_equal(read_auth["ok"], true)
	assert_equal(read_auth["role_key"], "anonymous")

	write_missing_auth := authorize_request({
		"method": "POST",
		"headers": {}
	}, ctx, get_header, false)
	assert_equal(write_missing_auth["ok"], false)
	assert_equal(write_missing_auth["error"], "Missing bearer token")

	write_bootstrap_auth := authorize_request({
		"method": "POST",
		"headers": {
			"Authorization": "Bearer contract-bootstrap-token-1234567890"
		}
	}, ctx, get_header, false)
	assert_equal(write_bootstrap_auth["ok"], true)
	assert_equal(write_bootstrap_auth["role_key"], "super_admin")

	_ := db_execute_safe(
		connection["db"],
		"INSERT INTO api_tokens (token_hash, label, role_key, is_active, created_at, updated_at, expires_at, last_used_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
		[sha256("contract-editor-token-123"), "Contract Editor", "editor", 1, now(), now(), null, null]
	)

	editor_admin_auth := authorize_request({
		"method": "POST",
		"headers": {
			"Authorization": "Bearer contract-editor-token-123"
		}
	}, ctx, get_header, "admin.auth")
	assert_equal(editor_admin_auth["ok"], false)
	assert_equal(editor_admin_auth["status"], 403)

	bootstrap_admin_auth := authorize_request({
		"method": "POST",
		"headers": {
			"Authorization": "Bearer contract-bootstrap-token-1234567890"
		}
	}, ctx, get_header, "admin.auth")
	assert_equal(bootstrap_admin_auth["ok"], true)

	if file_exists(db_path) {
		delete_file(db_path)
	}
	if file_exists(db_path + "-wal") {
		delete_file(db_path + "-wal")
	}
	if file_exists(db_path + "-shm") {
		delete_file(db_path + "-shm")
	}
}

test "anonymous entry visibility is limited to published content" {
	anonymous := {"role_key": "anonymous", "permissions": ["cms.read"]}
	editor := {"role_key": "editor", "permissions": ["cms.read", "cms.write"]}

	assert_equal(can_read_entry_status(anonymous, "published"), true)
	assert_equal(can_read_entry_status(anonymous, "draft"), false)
	assert_equal(can_read_entry_status(anonymous, "scheduled"), false)
	assert_equal(can_read_entry_status(anonymous, "archived"), false)
	assert_equal(can_read_entry_status(editor, "draft"), true)
}

test "auth token expiry parsing supports epoch and ISO and rejects invalid format" {
	if path_exists("results") == false {
		create_dir("results")
	}

	db_path := "./results/test_auth_expiry_contract.db"
	cfg := load_config({
		"db_path": db_path,
		"api_token": "contract-bootstrap-token-1234567890",
		"allow_bootstrap_token": true,
		"audit_log": false
	})

	connection := connect_database(cfg)
	assert_equal(connection["ok"], true)
	db := connection["db"]

	_ := db_execute_safe(
		db,
		"INSERT INTO entries (id, content_type_key, title, slug, status, excerpt, body, meta_json, author_id, published_at, unpublish_at, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
		[101, "article", "Lock 101", "lock-101", "draft", "", "", "{}", "tester", null, null, now(), now()]
	)
	_ := db_execute_safe(
		db,
		"INSERT INTO entries (id, content_type_key, title, slug, status, excerpt, body, meta_json, author_id, published_at, unpublish_at, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
		[102, "article", "Lock 102", "lock-102", "draft", "", "", "{}", "tester", null, null, now(), now()]
	)
	_ := db_execute_safe(
		db,
		"INSERT INTO entries (id, content_type_key, title, slug, status, excerpt, body, meta_json, author_id, published_at, unpublish_at, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
		[103, "article", "Lock 103", "lock-103", "draft", "", "", "{}", "tester", null, null, now(), now()]
	)

	now_ms := to_int(now())
	valid_epoch_ms := now_ms + 60000

	_ := db_execute_safe(
		db,
		"INSERT INTO api_tokens (token_hash, label, role_key, is_active, created_at, updated_at, expires_at, last_used_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
		[sha256("contract-epoch-token-123"), "Epoch Token", "super_admin", 1, now(), now(), valid_epoch_ms, null]
	)

	_ := db_execute_safe(
		db,
		"INSERT INTO api_tokens (token_hash, label, role_key, is_active, created_at, updated_at, expires_at, last_used_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
		[sha256("contract-iso-token-123"), "ISO Token", "super_admin", 1, now(), now(), "2030-01-01T00:00:00Z", null]
	)

	_ := db_execute_safe(
		db,
		"INSERT INTO api_tokens (token_hash, label, role_key, is_active, created_at, updated_at, expires_at, last_used_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
		[sha256("contract-expired-token-123"), "Expired Token", "super_admin", 1, now(), now(), 1, null]
	)

	_ := db_execute_safe(
		db,
		"INSERT INTO api_tokens (token_hash, label, role_key, is_active, created_at, updated_at, expires_at, last_used_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
		[sha256("contract-bad-expiry-token-123"), "Bad Expiry Token", "super_admin", 1, now(), now(), "not-a-timestamp", null]
	)

	ctx := {
		"cfg": cfg,
		"db": db,
		"state": {
			"rate": {},
			"entry_locks": {}
		}
	}

	epoch_auth := authorize_request({
		"method": "POST",
		"headers": {
			"Authorization": "Bearer contract-epoch-token-123"
		}
	}, ctx, get_header, false)
	assert_equal(epoch_auth["ok"], true)

	iso_auth := authorize_request({
		"method": "POST",
		"headers": {
			"Authorization": "Bearer contract-iso-token-123"
		}
	}, ctx, get_header, false)
	assert_equal(iso_auth["ok"], true)

	expired_auth := authorize_request({
		"method": "POST",
		"headers": {
			"Authorization": "Bearer contract-expired-token-123"
		}
	}, ctx, get_header, false)
	assert_equal(expired_auth["ok"], false)
	assert_equal(expired_auth["error"], "Token expired")

	bad_expiry_auth := authorize_request({
		"method": "POST",
		"headers": {
			"Authorization": "Bearer contract-bad-expiry-token-123"
		}
	}, ctx, get_header, false)
	assert_equal(bad_expiry_auth["ok"], false)
	assert_equal(bad_expiry_auth["error"], "Token expiry format invalid")

	if file_exists(db_path) {
		delete_file(db_path)
	}
	if file_exists(db_path + "-wal") {
		delete_file(db_path + "-wal")
	}
	if file_exists(db_path + "-shm") {
		delete_file(db_path + "-shm")
	}
}

test "entry lock expiry cleanup removes expired epoch locks" {
	if path_exists("results") == false {
		create_dir("results")
	}

	db_path := "./results/test_entry_lock_expiry_contract.db"
	if file_exists(db_path) {
		delete_file(db_path)
	}
	if file_exists(db_path + "-wal") {
		delete_file(db_path + "-wal")
	}
	if file_exists(db_path + "-shm") {
		delete_file(db_path + "-shm")
	}

	cfg := load_config({
		"db_path": db_path,
		"api_token": "contract-lock-token-1234567890",
		"audit_log": false
	})

	connection := connect_database(cfg)
	assert_equal(connection["ok"], true)
	db := connection["db"]

	now_ts := now()
	expired_epoch := now_ts - 5000
	future_epoch := now_ts + 60000

	entry_101_result := db_execute_safe(
		db,
		"INSERT INTO entries (content_type_key, title, slug, status, excerpt, body, meta_json, author_id, published_at, unpublish_at, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
		["article", "Lock 101", "lock-101", "draft", "", "", "{}", "tester", null, null, now(), now()]
	)
	assert_equal(entry_101_result["ok"], true)
	entry_101_rows := db_query_safe(db, "SELECT id FROM entries WHERE slug = ? LIMIT 1", ["lock-101"])
	assert_equal(entry_101_rows["ok"], true)
	assert_equal(len(entry_101_rows["rows"]), 1)
	entry_101_id := entry_101_rows["rows"][0]["id"]

	entry_102_result := db_execute_safe(
		db,
		"INSERT INTO entries (content_type_key, title, slug, status, excerpt, body, meta_json, author_id, published_at, unpublish_at, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
		["article", "Lock 102", "lock-102", "draft", "", "", "{}", "tester", null, null, now(), now()]
	)
	assert_equal(entry_102_result["ok"], true)
	entry_102_rows := db_query_safe(db, "SELECT id FROM entries WHERE slug = ? LIMIT 1", ["lock-102"])
	assert_equal(entry_102_rows["ok"], true)
	assert_equal(len(entry_102_rows["rows"]), 1)
	entry_102_id := entry_102_rows["rows"][0]["id"]

	_ := db_execute_safe(
		db,
		"INSERT INTO entry_locks (entry_id, lock_token, locked_by, lock_note, locked_at, expires_at) VALUES (?, ?, ?, ?, ?, ?)",
		[entry_101_id, "lock-expired-epoch", "tester", "epoch expired", to_string(now_ts), to_string(expired_epoch)]
	)
	_ := db_execute_safe(
		db,
		"INSERT INTO entry_locks (entry_id, lock_token, locked_by, lock_note, locked_at, expires_at) VALUES (?, ?, ?, ?, ?, ?)",
		[entry_102_id, "lock-active-epoch", "tester", "epoch active", to_string(now_ts), to_string(future_epoch)]
	)

	_ := db_execute_safe(
		db,
		"DELETE FROM entry_locks WHERE CASE WHEN instr(CAST(expires_at AS TEXT), '-') > 0 THEN CAST(strftime('%s', expires_at) AS INTEGER) * 1000 ELSE CAST(expires_at AS INTEGER) END <= ?",
		[now_ts]
	)

	remaining := db_query_safe(db, "SELECT entry_id FROM entry_locks ORDER BY entry_id ASC", [])
	assert_equal(remaining["ok"], true)
	assert_equal(len(remaining["rows"]), 1)
	assert_equal(remaining["rows"][0]["entry_id"], entry_102_id)

	if file_exists(db_path) {
		delete_file(db_path)
	}
	if file_exists(db_path + "-wal") {
		delete_file(db_path + "-wal")
	}
	if file_exists(db_path + "-shm") {
		delete_file(db_path + "-shm")
	}
}

test "request actor hashing does not disclose bearer secrets" {
	raw_token := "super-secret-token-value"
	actor := req_actor({
		"headers": {
			"Authorization": "Bearer " + raw_token
		}
	})
	expected_actor := "token:" + substring(sha256(raw_token), 0, 12)

	assert_equal(actor, expected_actor)
	assert_equal(req_actor({"headers": {}}), "anonymous")
}
